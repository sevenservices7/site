---
import { useTranslations, getRoute, type Lang, type RouteKey } from '../i18n/ui';
import LangSwitcher from './LangSwitcher.astro';
import { STAGES, solutionsByStageFor, solutionFor, solutionPath } from '../data/solucoes';
import { getUi } from '../data/ui';

interface Props {
  lang: Lang;
  routeKey?: RouteKey;
  /** Caminhos desta mesma página nos outros idiomas (páginas de solução). */
  alternates?: Partial<Record<Lang, string>>;
}
const { lang, routeKey, alternates } = Astro.props;
const t = useTranslations(lang);
const u = getUi(lang);
const home = getRoute('home', lang);
const hub = getRoute('solutions', lang);
const isPt = lang === 'pt';

// Atalhos para as soluções de empresa e contabilidade, quando já existem no idioma.
const shortcut = (key: string, label: string) => {
  const s = solutionFor(lang, key);
  return s ? [{ label, href: solutionPath(lang, s) }] : [];
};
const links: { label: string; href: string }[] = [
  ...shortcut('abrir-empresa-em-portugal', t('nav.companies')),
  ...shortcut('contabilidade-em-portugal', t('nav.accounting')),
  ...(isPt ? [{ label: t('nav.blog'), href: '/blog' }, { label: t('nav.podcast'), href: '/podcast' }] : []),
  { label: t('nav.about'), href: getRoute('about', lang) },
];
const groups = STAGES
  .map((st) => ({ id: st.id, title: u.stages[st.id].title, items: solutionsByStageFor(lang, st.id) }))
  .filter((g) => g.items.length);
---
<header class="nav" data-header>
  <div class="container nav-inner">
    <a href={home} class="nav-brand" aria-label={`SEVEN — ${u.common.home}`}>
      <img src="/brand/seven-horizontal-areia.svg" alt="SEVEN" width="196" height="40" />
      <span class="nav-slogan">{t('brand.slogan')}</span>
    </a>

    <button class="nav-burger" aria-label="Menu" aria-expanded="false" data-burger>
      <span></span><span></span><span></span>
    </button>

    <nav class="nav-menu" data-nav>
      <ul class="nav-links">
        {groups.length > 0 && (
          <li class="nav-drop">
            <a href={hub} class="nav-drop-btn" aria-haspopup="true">{t('nav.solutions')}<svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M1 3l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></a>
            <div class="nav-mega">
              <div class="nav-mega-in">
                {groups.map((g) => (
                  <div class="nav-mega-col">
                    <span class="nav-mega-h">{g.title}</span>
                    <ul>{g.items.map((it) => <li><a href={solutionPath(lang, it)}>{it.navLabel}</a></li>)}</ul>
                  </div>
                ))}
              </div>
              <a href={hub} class="nav-mega-all">{u.common.seeAllSolutions}</a>
            </div>
          </li>
        )}
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
      <div class="nav-actions">
        <LangSwitcher lang={lang} routeKey={routeKey} alternates={alternates} />
        <a href={getRoute('booking', lang)} class="nav-book">{u.common.bookConsult}</a>
        <a href={getRoute('expert', lang)} class="btn btn-gold btn-sm">{t('nav.booking')}</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .nav { position: sticky; top: 0; z-index: 40; background: var(--surface-brand); color: var(--nevoa); border-bottom: 1px solid var(--complementar-1); }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; height: 84px; gap: 18px; }
  .nav-brand { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; flex: none; }
  .nav-brand img { height: 36px; width: auto; }
  .nav-slogan { font-family: var(--font-head); font-weight: 400; font-size: .72rem; line-height: 1; letter-spacing: .02em; color: var(--complementar-2); white-space: nowrap; }
  .nav-menu { display: flex; align-items: center; gap: 28px; }
  .nav-links { display: flex; gap: 28px; list-style: none; }
  .nav-links a {
    color: var(--nevoa); font-family: var(--font-head); font-weight: 500; font-size: .76rem;
    text-transform: uppercase; letter-spacing: 0.12em; white-space: nowrap;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .nav-links a:hover { color: var(--g1); }
  .nav-actions { display: flex; align-items: center; gap: 16px; }
  .nav-actions .btn { white-space: nowrap; }
  .nav-book { color: var(--areia); font-family: var(--font-head); font-weight: 600; font-size: .8rem; white-space: nowrap; border-bottom: 1px solid transparent; }
  .nav-book:hover { border-color: var(--areia); }
  @media (min-width: 961px) and (max-width: 1400px) { .nav-book { display: none; } }
  @media (max-width: 1360px) { .nav-menu, .nav-links { gap: 22px; } }
  .nav-drop { position: relative; }
  .nav-drop-btn { display: inline-flex; align-items: center; gap: 6px; }
  .nav-mega {
    position: absolute; top: calc(100% + 30px); left: -24px; width: min(860px, 80vw); display: none;
    background: var(--surface); border-top: 3px solid var(--accent); padding: 28px 28px 20px; z-index: 50;
  }
  .nav-drop::after { content: ''; position: absolute; left: 0; right: 0; top: 100%; height: 32px; }
  .nav-drop:hover .nav-mega, .nav-drop:focus-within .nav-mega { display: block; }
  .nav-mega-in { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px 32px; }
  .nav-mega-h { display: block; font-size: 12px; font-weight: 500; letter-spacing: .2em; text-transform: uppercase; color: var(--ink-muted); margin-bottom: 10px; }
  .nav-mega ul { list-style: none; display: flex; flex-direction: column; gap: 8px; }
  .nav-mega a { color: var(--heading); font-size: .92rem; font-weight: 500; text-transform: none; letter-spacing: 0; }
  .nav-mega a:hover { color: var(--complementar-1); text-decoration: underline; text-underline-offset: 3px; }
  .nav-mega .nav-mega-all { display: inline-block; margin-top: 20px; padding-top: 14px; border-top: 1px solid var(--border); width: 100%; font-size: 13px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
  .nav-burger { display: none; flex-direction: column; gap: 5px; background: none; border: 0; cursor: pointer; padding: 8px; }
  .nav-burger span { width: 24px; height: 2px; background: var(--nevoa); }

  @media (max-width: 960px) {
    .nav-inner { height: 72px; }
    .nav-brand img { height: 30px; }
    .nav-slogan { font-size: .66rem; }
    .nav-burger { display: flex; }
    .nav-menu {
      position: absolute; top: 100%; left: 0; right: 0; flex-direction: column; align-items: flex-start; gap: 8px;
      background: var(--surface-brand); padding: 18px var(--gutter) 24px;
      border-bottom: 1px solid var(--complementar-1); display: none;
    }
    .nav-menu[data-open] { display: flex; }
    .nav-links { flex-direction: column; gap: 4px; width: 100%; }
    .nav-links a { display: block; padding: 10px 0; }
    .nav-drop::after { display: none; }
    .nav-mega { position: static; display: block; width: auto; background: transparent; border: 0; padding: 0 0 8px 14px; }
    .nav-mega-in { grid-template-columns: 1fr; gap: 12px; }
    .nav-mega-h { color: var(--complementar-2); margin-bottom: 4px; }
    .nav-mega a { color: var(--nevoa); padding: 4px 0; }
    .nav-mega .nav-mega-all { border-color: var(--complementar-1); color: var(--areia); margin-top: 8px; }
    .nav-menu { max-height: calc(100vh - 72px); overflow-y: auto; }
    .nav-actions { flex-wrap: wrap; gap: 14px; padding-top: 8px; width: 100%; }
  }
</style>

<script>
  const burger = document.querySelector('[data-burger]');
  const nav = document.querySelector('[data-nav]');
  burger?.addEventListener('click', () => {
    const open = nav?.hasAttribute('data-open');
    if (open) nav?.removeAttribute('data-open'); else nav?.setAttribute('data-open', '');
    burger.setAttribute('aria-expanded', String(!open));
  });
</script>
