---
import { getRoute, type Lang, type RouteKey } from '../i18n/ui';
import { getOffices } from '../lib/data';
import { SOCIAL } from '../lib/site';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  routeKey?: RouteKey;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** Blocos JSON-LD extra desta página (Service, FAQPage, BreadcrumbList, Article…). */
  jsonLd?: Record<string, unknown>[];
  alternates?: Partial<Record<Lang, string>>;
}
const { title, description, lang, routeKey, ogImage = '/brand/og-image.png', ogType = 'website', noindex = false, jsonLd = [], alternates: altPaths } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://seveneu.com';
const ogLocale = { pt: 'pt_BR', en: 'en_GB', es: 'es_ES', fr: 'fr_FR' }[lang];
const hreflang = { pt: 'pt-BR', en: 'en', es: 'es', fr: 'fr' } as const;
const canonical = site + Astro.url.pathname;

// Alternates hreflang quando a rota é conhecida nos 3 idiomas.
const alternates = altPaths
  ? (Object.entries(altPaths) as [Lang, string][]).map(([l, p]) => ({ lang: hreflang[l], href: site + p }))
  : routeKey
    ? (['pt', 'en', 'es', 'fr'] as Lang[]).map((l) => ({ lang: hreflang[l], href: site + getRoute(routeKey, l) }))
    : [];
const xDefault = altPaths ? (altPaths.pt ? site + altPaths.pt : '') : routeKey ? site + getRoute(routeKey, 'pt') : '';

// Organização + unidades (LocalBusiness) em todas as páginas.
const offices = await getOffices();
const org = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${site}/#organization`,
  name: 'SEVEN',
  legalName: 'SANTOS JESUS Unipessoal Lda',
  url: site + '/',
  logo: `${site}/brand/seven-simbolo-oceano.svg`,
  image: `${site}/brand/og-image.png`,
  slogan: 'Transformando complexidade em caminho. Clareza para ir além.',
  description: 'Assessoria especialista em imigração, empresas e contabilidade para brasileiros em Portugal.',
  areaServed: [{ '@type': 'Country', name: 'Portugal' }, { '@type': 'Country', name: 'Brasil' }],
  knowsLanguage: ['pt-BR', 'pt-PT', 'en', 'es'],
  sameAs: SOCIAL.map((n) => n.href).filter(Boolean),
  aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.9', reviewCount: '178', bestRating: '5' },
  department: offices.filter((o) => o.is_open).map((o) => ({
    '@type': 'ProfessionalService',
    name: `SEVEN ${o.name}`,
    address: { '@type': 'PostalAddress', streetAddress: o.address, addressLocality: o.name, addressCountry: 'PT' },
    ...(o.lat && o.lng ? { geo: { '@type': 'GeoCoordinates', latitude: o.lat, longitude: o.lng } } : {}),
    ...(o.whatsapp ? { telephone: '+' + o.whatsapp } : {}),
    url: `${site}/unidades/${o.slug}`,
  })),
};
const blocks = [org, ...jsonLd];
---
<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, follow" />}
<link rel="canonical" href={canonical} />
{alternates.length > 1 && alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
{alternates.length > 1 && xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="SEVEN" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={site + ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={ogLocale} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={site + ogImage} />
{blocks.map((b) => <script type="application/ld+json" set:html={JSON.stringify(b)} />)}
