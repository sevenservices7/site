---
import { useTranslations, getRoute, unitPath, type Lang } from '../i18n/ui';
import { getOffices } from '../lib/data';
import { STAGES, solutionsFor, solutionPath } from '../data/solucoes';
import { getUi } from '../data/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const offices = await getOffices();
const year = new Date().getFullYear();
const isPt = lang === 'pt';
const u = getUi(lang);
const stageOrder = new Map(STAGES.map((st, i) => [st.id, i]));
const footerSolutions = [...solutionsFor(lang)]
  .sort((a, b) => (stageOrder.get(a.stage)! - stageOrder.get(b.stage)!) || a.navLabel.localeCompare(b.navLabel))
  .slice(0, 8);

const unitHref = (slug: string) => unitPath(slug, lang);
const cookiePrefs = { pt: 'Preferências de cookies', en: 'Cookie preferences', es: 'Preferencias de cookies', fr: 'Préférences de cookies' }[lang];
---
<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <img src="/brand/seven-horizontal-areia.svg" alt="SEVEN" width="196" height="40" />
        <p class="footer-slogan">{t('brand.slogan')}</p>
        <p>{t('footer.tagline')}</p>
        <p class="footer-legal">{t('footer.legalEntity')}</p>
      </div>

      <div class="footer-col">
        <h5>{t('footer.solutions')}</h5>
        <ul>
          {footerSolutions.map((x) => <li><a href={solutionPath(lang, x)}>{x.navLabel}</a></li>)}
          <li><a href={getRoute('solutions', lang)}>{u.common.seeAllSolutions}</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h5>SEVEN</h5>
        <ul>
          <li><a href={getRoute('about', lang)}>{t('nav.about')}</a></li>
          <li><a href={`${getRoute('about', lang)}#equipe`}>{t('nav.team')}</a></li>
          <li><a href={getRoute('booking', lang)}>{t('nav.booking')}</a></li>
          {isPt && <li><a href="/blog">{t('nav.blog')}</a></li>}
          {isPt && <li><a href="/podcast">{t('nav.podcast')}</a></li>}
        </ul>
      </div>

      <div class="footer-col">
        <h5>{t('footer.units')}</h5>
        <ul>
          {offices.map((o) => <li><a href={unitHref(o.slug)}>{o.name}</a></li>)}
          <li><a href={getRoute('contact', lang)}>{t('nav.contact')}</a></li>
          <li><a href={getRoute('terms', lang)}>{t('footer.terms')}</a></li>
          <li><a href={getRoute('privacy', lang)}>{t('footer.privacy')}</a></li>
          <li><button type="button" class="footer-link" data-cookie-prefs>{cookiePrefs}</button></li>
        </ul>
      </div>
    </div>

    <div class="footer-fine">
      <span>© {year} SEVEN · {t('site.tagline')}</span>
      <span>NIPC 518 146 529</span>
    </div>
  </div>
</footer>

<style>
  .footer { background: var(--surface-brand); color: var(--nevoa); padding: clamp(48px, 7vw, 64px) 0 32px; }
  .footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 40px; margin-bottom: 48px; }
  .footer-brand img { height: 40px; width: auto; margin-bottom: 20px; }
  .footer-slogan { font-family: var(--font-head); font-weight: 500; color: var(--areia) !important; font-size: 1.05rem !important; max-width: none !important; margin-bottom: 12px; }
  .footer-brand p { color: var(--complementar-2); font-size: .9rem; max-width: 30ch; line-height: 1.6; }
  .footer-legal { margin-top: 12px; font-size: .8rem; color: var(--complementar-2) !important; }
  .footer-col h5 { font-family: var(--font-head); font-weight: 500; font-size: .72rem; text-transform: uppercase; letter-spacing: 0.2em; color: var(--areia); margin-bottom: 16px; }
  .footer-col ul { list-style: none; display: flex; flex-direction: column; gap: 10px; }
  .footer-col a { color: var(--nevoa); font-size: .92rem; transition: color var(--dur-fast) var(--ease-out); }
  .footer-col a:hover, .footer-link:hover { color: var(--areia); }
  .footer-link { background: none; border: 0; padding: 0; cursor: pointer; font: inherit; color: var(--nevoa); font-size: .92rem; text-align: left; }
  .footer-fine { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding-top: 24px; border-top: 1px solid var(--complementar-1); font-size: .8rem; color: var(--complementar-2); }
  @media (max-width: 820px) { .footer-grid { grid-template-columns: 1fr 1fr; gap: 32px; } }
  @media (max-width: 520px) { .footer-grid { grid-template-columns: 1fr; } }
</style>
