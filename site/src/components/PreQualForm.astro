---
// Formulário "Falar com especialista" em tela cheia, uma pergunta por vez (estilo G4).
// O lead nasce no e-mail (pergunta 2) e cada resposta seguinte é gravada assim que a pessoa avança:
// quem desiste no meio não se perde, a equipa é avisada e, com autorização, recebe um e-mail após 30 minutos.
import { getRoute, type Lang } from '../i18n/ui';
import { countryList } from '../lib/countries';
import { mainWhatsapp } from '../lib/site';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const countries = countryList(lang);
const first = countries[0];
const wa = await mainWhatsapp();
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';

const C = {
  pt: {
    close: 'Voltar ao site', ok: 'OK', enter: 'pressione Enter ↵', back: 'Voltar', send: 'Enviar', optional: 'opcional',
    name: 'Para começar, qual é o seu nome?', namePh: 'Seu nome completo',
    email: 'Prazer, {name}! Qual é o seu melhor e-mail?', emailPh: 'nome@exemplo.com',
    consent: 'Autorizo a SEVEN a falar comigo por WhatsApp e e-mail sobre este pedido, inclusive com lembretes. Posso cancelar quando quiser.',
    privacy: 'Seus dados são usados só para responder ao seu pedido.', policy: 'Política de Privacidade',
    phone: 'Qual é o seu WhatsApp?', phoneHint: 'É por ele que o especialista vai falar com você.', phonePh: 'Seu número',
    ddi: 'País (DDI)', ddiSearch: 'Buscar país ou DDI (ex.: Portugal ou +351)', ddiNone: 'Nenhum país encontrado',
    topic: 'O que você quer resolver?',
    topics: { visto: 'Vir para Portugal / visto', residencia: 'Residência ou renovação', familia: 'Trazer a família', nacionalidade: 'Nacionalidade portuguesa', documentos: 'NIF, NISS e primeiros documentos', empresa: 'Abrir empresa / contabilidade', irs: 'IRS e impostos', carta: 'Carta de condução ou carro', consular: 'Serviços consulares brasileiros', juridico: 'Problema jurídico / recurso', outro: 'Outro assunto' },
    urgency: 'Qual a urgência?', urgencies: { urgente: 'Urgente: tenho prazo ou notificação', semanas: 'Nas próximas semanas', meses: 'Nos próximos meses', pesquisando: 'Só estou pesquisando' },
    location: 'Onde você está agora?', locations: { portugal: 'Em Portugal', brasil: 'No Brasil', outro: 'Em outro país' },
    contact: 'Como prefere ser contactado?', contacts: { whatsapp: 'WhatsApp', email: 'E-mail', ligacao: 'Ligação' },
    message: 'Quer contar o seu caso em poucas palavras?', messagePh: 'Ex.: meu título vence mês que vem e não consigo agendar na AIMA.',
    required: 'Preencha para continuar.', invalidEmail: 'Confira o e-mail.', invalidPhone: 'Confira o número.',
    error: 'Não deu para enviar. Tente de novo ou chame a gente no WhatsApp.',
    doneTitle: 'Recebido! A gente fala com você em até 1 dia útil.', doneBody: 'Um especialista vai analisar o seu caso e entrar em contato pelo canal que você escolheu.',
    whatsapp: 'Chamar no WhatsApp agora', home: 'Voltar ao site',
  },
  en: {
    close: 'Back to the site', ok: 'OK', enter: 'press Enter ↵', back: 'Back', send: 'Send', optional: 'optional',
    name: 'To start, what’s your name?', namePh: 'Your full name',
    email: 'Nice to meet you, {name}! What’s your best email?', emailPh: 'name@example.com',
    consent: 'I authorise SEVEN to contact me on WhatsApp and by email about this request, including reminders. I can withdraw at any time.',
    privacy: 'Your data is only used to reply to your request.', policy: 'Privacy Policy',
    phone: 'What’s your WhatsApp number?', phoneHint: 'That’s where the specialist will reach you.', phonePh: 'Your number',
    ddi: 'Country (dialling code)', ddiSearch: 'Search country or code (e.g. Portugal or +351)', ddiNone: 'No country found',
    topic: 'What would you like to solve?',
    topics: { visto: 'Moving to Portugal / visa', residencia: 'Residence permit or renewal', familia: 'Bringing my family', nacionalidade: 'Portuguese citizenship', documentos: 'NIF, NISS and first documents', empresa: 'Company / accounting', irs: 'IRS and taxes', carta: 'Driving licence or car', consular: 'Brazilian consular services', juridico: 'Legal issue / appeal', outro: 'Something else' },
    urgency: 'How urgent is it?', urgencies: { urgente: 'Urgent: I have a deadline or notice', semanas: 'In the coming weeks', meses: 'In the coming months', pesquisando: 'Just researching' },
    location: 'Where are you now?', locations: { portugal: 'In Portugal', brasil: 'In Brazil', outro: 'In another country' },
    contact: 'How would you like to be contacted?', contacts: { whatsapp: 'WhatsApp', email: 'Email', ligacao: 'Phone call' },
    message: 'Want to tell us about your case in a few words?', messagePh: 'E.g. my permit expires next month and I can’t get an AIMA appointment.',
    required: 'Please fill this in to continue.', invalidEmail: 'Please check the email.', invalidPhone: 'Please check the number.',
    error: 'We couldn’t send it. Please try again or message us on WhatsApp.',
    doneTitle: 'Received! We’ll get back to you within 1 business day.', doneBody: 'A specialist will review your case and contact you through the channel you chose.',
    whatsapp: 'Message us on WhatsApp now', home: 'Back to the site',
  },
  es: {
    close: 'Volver al sitio', ok: 'OK', enter: 'pulsa Enter ↵', back: 'Volver', send: 'Enviar', optional: 'opcional',
    name: 'Para empezar, ¿cómo te llamas?', namePh: 'Tu nombre completo',
    email: '¡Encantados, {name}! ¿Cuál es tu mejor correo?', emailPh: 'nombre@ejemplo.com',
    consent: 'Autorizo a SEVEN a contactarme por WhatsApp y correo sobre esta solicitud, incluso con recordatorios. Puedo retirarlo cuando quiera.',
    privacy: 'Tus datos solo se usan para responder a tu solicitud.', policy: 'Política de Privacidad',
    phone: '¿Cuál es tu WhatsApp?', phoneHint: 'Es por donde el especialista te contactará.', phonePh: 'Tu número',
    ddi: 'País (prefijo)', ddiSearch: 'Buscar país o prefijo (ej.: Portugal o +351)', ddiNone: 'Ningún país encontrado',
    topic: '¿Qué quieres resolver?',
    topics: { visto: 'Venir a Portugal / visado', residencia: 'Residencia o renovación', familia: 'Traer a la familia', nacionalidade: 'Nacionalidad portuguesa', documentos: 'NIF, NISS y primeros documentos', empresa: 'Empresa / contabilidad', irs: 'IRS e impuestos', carta: 'Licencia de conducir o coche', consular: 'Servicios consulares brasileños', juridico: 'Problema jurídico / recurso', outro: 'Otro asunto' },
    urgency: '¿Qué urgencia tiene?', urgencies: { urgente: 'Urgente: tengo un plazo o notificación', semanas: 'En las próximas semanas', meses: 'En los próximos meses', pesquisando: 'Solo estoy informándome' },
    location: '¿Dónde estás ahora?', locations: { portugal: 'En Portugal', brasil: 'En Brasil', outro: 'En otro país' },
    contact: '¿Cómo prefieres que te contactemos?', contacts: { whatsapp: 'WhatsApp', email: 'Correo', ligacao: 'Llamada' },
    message: '¿Quieres contarnos tu caso en pocas palabras?', messagePh: 'Ej.: mi permiso vence el mes que viene y no consigo cita en la AIMA.',
    required: 'Complétalo para continuar.', invalidEmail: 'Revisa el correo.', invalidPhone: 'Revisa el número.',
    error: 'No se pudo enviar. Inténtalo de nuevo o escríbenos por WhatsApp.',
    doneTitle: '¡Recibido! Te contactamos en 1 día hábil como máximo.', doneBody: 'Un especialista analizará tu caso y te contactará por el canal que elegiste.',
    whatsapp: 'Escribir por WhatsApp ahora', home: 'Volver al sitio',
  },
  fr: {
    close: 'Retour au site', ok: 'OK', enter: 'appuyez sur Entrée ↵', back: 'Retour', send: 'Envoyer', optional: 'facultatif',
    name: 'Pour commencer, quel est votre nom ?', namePh: 'Votre nom complet',
    email: 'Enchantés, {name} ! Quel est votre meilleur e-mail ?', emailPh: 'nom@exemple.com',
    consent: 'J’autorise SEVEN à me contacter sur WhatsApp et par e-mail au sujet de cette demande, y compris par des rappels. Je peux retirer mon accord à tout moment.',
    privacy: 'Vos données servent uniquement à répondre à votre demande.', policy: 'Politique de confidentialité',
    phone: 'Quel est votre WhatsApp ?', phoneHint: 'C’est là que le spécialiste vous contactera.', phonePh: 'Votre numéro',
    ddi: 'Pays (indicatif)', ddiSearch: 'Chercher un pays ou un indicatif (ex. : Portugal ou +351)', ddiNone: 'Aucun pays trouvé',
    topic: 'Que souhaitez-vous résoudre ?',
    topics: { visto: 'Venir au Portugal / visa', residencia: 'Titre de séjour ou renouvellement', familia: 'Faire venir ma famille', nacionalidade: 'Nationalité portugaise', documentos: 'NIF, NISS et premiers documents', empresa: 'Entreprise / comptabilité', irs: 'IRS et impôts', carta: 'Permis de conduire ou voiture', consular: 'Services consulaires brésiliens', juridico: 'Problème juridique / recours', outro: 'Autre sujet' },
    urgency: 'Quelle est l’urgence ?', urgencies: { urgente: 'Urgent : j’ai un délai ou une notification', semanas: 'Dans les prochaines semaines', meses: 'Dans les prochains mois', pesquisando: 'Je me renseigne' },
    location: 'Où êtes-vous actuellement ?', locations: { portugal: 'Au Portugal', brasil: 'Au Brésil', outro: 'Dans un autre pays' },
    contact: 'Comment préférez-vous être contacté ?', contacts: { whatsapp: 'WhatsApp', email: 'E-mail', ligacao: 'Appel' },
    message: 'Voulez-vous décrire votre situation en quelques mots ?', messagePh: 'Ex. : mon titre expire le mois prochain et je n’obtiens pas de rendez-vous à l’AIMA.',
    required: 'Remplissez ce champ pour continuer.', invalidEmail: 'Vérifiez l’e-mail.', invalidPhone: 'Vérifiez le numéro.',
    error: 'L’envoi a échoué. Réessayez ou écrivez-nous sur WhatsApp.',
    doneTitle: 'Bien reçu ! Nous revenons vers vous sous 1 jour ouvré.', doneBody: 'Un spécialiste va étudier votre situation et vous contacter par le canal choisi.',
    whatsapp: 'Écrire sur WhatsApp maintenant', home: 'Retour au site',
  },
}[lang] as any;

const LETTERS = 'ABCDEFGHIJKL';
// Perguntas de escolha: a chave é a mesma do servidor; ao clicar, grava e avança.
const choices = [
  { field: 'topic', q: C.topic, map: C.topics },
  { field: 'urgency', q: C.urgency, map: C.urgencies },
  { field: 'location', q: C.location, map: C.locations },
  { field: 'preferred_contact', q: C.contact, map: C.contacts },
];
const TOTAL = 3 + choices.length + 1; // nome, e-mail, WhatsApp, escolhas, caso
const home = getRoute('home', lang);
const waLink = `https://wa.me/${wa.replace(/\D/g, '')}`;
---
<div class="qf on-brand" data-qf data-lang={lang} data-total={TOTAL} data-required={C.required} data-invalid-email={C.invalidEmail} data-invalid-phone={C.invalidPhone} data-error={C.error}>
  <header class="qf-top">
    <a href={home} class="qf-logo"><img src="/brand/seven-horizontal-areia.svg" alt="SEVEN" width="150" height="31" /></a>
    <a href={home} class="qf-x" aria-label={C.close} title={C.close}>&times;</a>
    <div class="qf-progress" aria-hidden="true"><span data-qf-bar></span></div>
  </header>

  <div class="qf-stage">
    <!-- 1. Nome -->
    <form class="qf-step" data-qf-step="1" novalidate>
      <label class="qf-q" for="qf-name"><span class="qf-n">1 →</span>{C.name}</label>
      <input id="qf-name" class="qf-input" name="name" type="text" autocomplete="name" placeholder={C.namePh} required />
      <input type="text" name="company" tabindex="-1" autocomplete="off" class="qf-hp" aria-hidden="true" />
      <p class="qf-msg" data-qf-msg role="alert" hidden></p>
      <div class="qf-actions"><button type="submit" class="btn btn-gold">{C.ok} ✓</button><span class="qf-enter">{C.enter}</span></div>
    </form>

    <!-- 2. E-mail: aqui o lead é criado -->
    <form class="qf-step" data-qf-step="2" hidden novalidate>
      <label class="qf-q" for="qf-email"><span class="qf-n">2 →</span><span data-qf-email-q data-tpl={C.email}>{C.email.replace(', {name}', '').replace(' {name}', '')}</span></label>
      <input id="qf-email" class="qf-input" name="email" type="email" inputmode="email" autocomplete="email" placeholder={C.emailPh} required />
      <label class="qf-consent"><input type="checkbox" name="consent" value="1" /><span>{C.consent}</span></label>
      {turnstileKey && <div class="cf-turnstile" data-sitekey={turnstileKey} data-theme="dark"></div>}
      <p class="qf-privacy">{C.privacy} <a href={getRoute('privacy', lang)} target="_blank" rel="noopener">{C.policy}</a>.</p>
      <p class="qf-msg" data-qf-msg role="alert" hidden></p>
      <div class="qf-actions"><button type="submit" class="btn btn-gold">{C.ok} ✓</button><span class="qf-enter">{C.enter}</span></div>
    </form>

    <!-- 3. WhatsApp -->
    <form class="qf-step" data-qf-step="3" hidden novalidate>
      <label class="qf-q" id="qf-phone-q"><span class="qf-n">3 →</span>{C.phone}</label>
      <p class="qf-hint">{C.phoneHint}</p>
      <div class="qf-phone">
        <div class="ddi" data-ddi>
          <button type="button" class="ddi-btn" data-ddi-btn aria-haspopup="listbox" aria-expanded="false" aria-label={C.ddi}>
            <span data-ddi-label>{first.dial}</span><span class="ddi-iso" data-ddi-iso>{first.iso}</span>
            <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M1 3l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
          </button>
          <div class="ddi-pop" data-ddi-pop hidden>
            <input type="search" class="ddi-search" data-ddi-search placeholder={C.ddiSearch} aria-label={C.ddiSearch} autocomplete="off" />
            <ul class="ddi-list" role="listbox" data-ddi-list aria-labelledby="qf-phone-q">
              {countries.map((c, i) => (
                <li role="option" tabindex="-1" data-iso={c.iso} data-dial={c.dial} data-q={`${c.name} ${c.dial} ${c.iso}`} aria-selected={i === 0 ? 'true' : 'false'} class:list={[{ 'ddi-sep': i === 1 }]}>
                  <span class="ddi-name">{c.name}</span><span class="ddi-code">{c.dial}</span>
                </li>
              ))}
            </ul>
            <p class="ddi-none" data-ddi-none hidden>{C.ddiNone}</p>
          </div>
          <input type="hidden" name="ddi" value={first.dial} data-ddi-value />
        </div>
        <input class="qf-input" name="phone" type="tel" inputmode="tel" autocomplete="tel-national" placeholder={C.phonePh} aria-labelledby="qf-phone-q" required />
      </div>
      <p class="qf-msg" data-qf-msg role="alert" hidden></p>
      <div class="qf-actions"><button type="submit" class="btn btn-gold">{C.ok} ✓</button><span class="qf-enter">{C.enter}</span></div>
    </form>

    <!-- 4 a 7. Escolhas: um clique grava e avança -->
    {choices.map((ch, i) => (
      <form class="qf-step" data-qf-step={String(4 + i)} data-qf-choice={ch.field} hidden novalidate>
        <p class="qf-q"><span class="qf-n">{4 + i} →</span>{ch.q}</p>
        <div class:list={['qf-opts', { 'qf-opts--many': Object.keys(ch.map).length > 6 }]} role="radiogroup">
          {Object.entries(ch.map).map(([value, text], j) => (
            <button type="button" class="qf-opt" data-value={value} data-key={LETTERS[j]} role="radio" aria-checked="false">
              <span class="qf-key">{LETTERS[j]}</span>{text as string}
            </button>
          ))}
        </div>
        <p class="qf-msg" data-qf-msg role="alert" hidden></p>
      </form>
    ))}

    <!-- 8. Caso (opcional): conclui -->
    <form class="qf-step" data-qf-step={String(TOTAL)} hidden novalidate>
      <label class="qf-q" for="qf-message"><span class="qf-n">{TOTAL} →</span>{C.message} <small>({C.optional})</small></label>
      <textarea id="qf-message" class="qf-input qf-area" name="message" rows="3" placeholder={C.messagePh}></textarea>
      <p class="qf-msg" data-qf-msg role="alert" hidden></p>
      <div class="qf-actions"><button type="submit" class="btn btn-gold">{C.send} ✓</button></div>
    </form>

    <!-- Concluído -->
    <div class="qf-step qf-done" data-qf-step={String(TOTAL + 1)} hidden>
      <div class="qf-check" aria-hidden="true">✓</div>
      <h1 class="qf-q">{C.doneTitle}</h1>
      <p class="qf-hint">{C.doneBody}</p>
      <div class="qf-actions">
        {wa && <a href={waLink} class="btn btn-gold" target="_blank" rel="noopener">{C.whatsapp}</a>}
        <a href={home} class="btn btn-ghost">{C.home}</a>
      </div>
    </div>
  </div>

  <nav class="qf-nav" data-qf-nav hidden>
    <button type="button" class="qf-back" data-qf-back>↑ {C.back}</button>
  </nav>
</div>

{turnstileKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<style>
  .qf { min-height: 100vh; min-height: 100dvh; background: var(--surface-brand); color: var(--nevoa); display: flex; flex-direction: column; }
  .qf-top { position: relative; display: flex; align-items: center; justify-content: space-between; padding: 18px clamp(16px, 4vw, 40px); }
  .qf-logo img { height: 30px; width: auto; display: block; }
  .qf-x { font-size: 2rem; line-height: 1; color: var(--complementar-2); padding: 4px 8px; }
  .qf-x:hover { color: var(--areia); }
  .qf-progress { position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: var(--complementar-1); }
  .qf-progress span { display: block; height: 100%; width: 0; background: var(--areia); transition: width .35s ease; }
  .qf-stage { flex: 1; display: flex; align-items: center; justify-content: center; padding: clamp(24px, 6vw, 64px) 16px 96px; }
  .qf-step { width: min(680px, 100%); display: grid; gap: 18px; animation: qf-in .35s ease both; }
  .qf-step[hidden] { display: none; }
  @keyframes qf-in { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  .qf-q { font-family: var(--font-head); font-weight: 600; font-size: clamp(1.35rem, 3.2vw, 2rem); line-height: 1.25; color: var(--branco); display: block; }
  .qf-q small { font-size: .55em; font-weight: 400; color: var(--complementar-2); }
  .qf-n { display: inline-block; margin-right: 10px; font-size: .6em; vertical-align: middle; color: var(--areia); font-weight: 600; }
  .qf-hint { color: var(--complementar-2); font-size: 1rem; margin-top: -8px; }
  .qf-input {
    width: 100%; font: inherit; font-size: clamp(1.15rem, 2.6vw, 1.5rem); color: var(--branco); background: transparent;
    border: 0; border-bottom: 2px solid var(--complementar-1); padding: 10px 2px; border-radius: 0; outline: none; transition: border-color .15s;
  }
  .qf-input::placeholder { color: var(--complementar-1); }
  .qf-input:focus { border-color: var(--areia); }
  .qf-area { resize: vertical; min-height: 96px; font-size: 1.1rem; line-height: 1.5; }
  .qf-hp { position: absolute; left: -9999px; width: 1px; height: 1px; }
  .qf-consent { display: flex; gap: 10px; align-items: flex-start; font-size: .88rem; line-height: 1.5; color: var(--nevoa); cursor: pointer; }
  .qf-consent input { width: 18px; height: 18px; margin-top: 2px; flex: none; accent-color: var(--areia); }
  .qf-privacy { font-size: .8rem; color: var(--complementar-2); }
  .qf-privacy a { color: var(--areia); text-decoration: underline; text-underline-offset: 2px; }
  .qf-msg { font-size: .9rem; padding: 8px 12px; background: rgba(254, 226, 226, .12); color: #FCA5A5; border-left: 3px solid #F87171; }
  .qf-actions { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .qf-enter { font-size: .8rem; color: var(--complementar-2); }
  .qf-opts { display: grid; gap: 10px; max-width: 520px; }
  .qf-opts--many { max-width: none; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
  .qf-opt {
    display: flex; align-items: center; gap: 12px; text-align: left; font: inherit; font-size: 1.02rem; color: var(--branco); cursor: pointer;
    background: rgba(255, 255, 255, .04); border: 1px solid var(--complementar-1); padding: 12px 14px; transition: background .15s, border-color .15s;
  }
  .qf-opt:hover { border-color: var(--areia); background: rgba(214, 196, 150, .08); }
  .qf-opt[aria-checked='true'] { border-color: var(--areia); background: rgba(214, 196, 150, .18); }
  .qf-key { display: grid; place-items: center; width: 26px; height: 26px; flex: none; font-size: .78rem; font-weight: 700; border: 1px solid var(--complementar-2); color: var(--areia); }
  .qf-opt[aria-checked='true'] .qf-key { background: var(--areia); color: var(--surface-brand); border-color: var(--areia); }
  .qf-phone { display: grid; grid-template-columns: auto 1fr; gap: 12px; align-items: end; }
  .qf-nav { position: fixed; right: clamp(16px, 4vw, 40px); bottom: 20px; }
  .qf-nav[hidden] { display: none; }
  .qf-back { font: inherit; font-size: .9rem; color: var(--nevoa); background: transparent; border: 1px solid var(--complementar-1); padding: 8px 14px; cursor: pointer; }
  .qf-back:hover { border-color: var(--areia); color: var(--areia); }
  .qf-check { width: 56px; height: 56px; display: grid; place-items: center; background: var(--areia); color: var(--surface-brand); font-size: 1.8rem; font-weight: 700; }
  /* Seletor de DDI */
  .ddi { position: relative; }
  .ddi-btn { display: inline-flex; align-items: center; gap: 6px; font: inherit; font-size: 1.15rem; padding: 10px 6px; border: 0; border-bottom: 2px solid var(--complementar-1); background: transparent; color: var(--branco); cursor: pointer; white-space: nowrap; }
  .ddi-btn[aria-expanded="true"] { border-color: var(--areia); }
  .ddi-iso { font-size: .72rem; color: var(--complementar-2); letter-spacing: .06em; }
  .ddi-pop { position: absolute; z-index: 5; top: calc(100% + 6px); left: 0; width: min(340px, 86vw); background: var(--surface); border-top: 3px solid var(--accent); padding: 8px; box-shadow: 0 12px 30px rgba(0,0,0,.3); }
  .ddi-pop[hidden] { display: none; }
  .ddi-search { width: 100%; font: inherit; padding: 9px 10px; border: 1px solid var(--border-strong); color: var(--ink); background: var(--surface-alt); }
  .ddi-list { list-style: none; max-height: 240px; overflow-y: auto; margin: 6px 0 0; padding: 0; }
  .ddi-list li { display: flex; justify-content: space-between; gap: 12px; padding: 8px 10px; cursor: pointer; font-size: .92rem; color: var(--ink); }
  .ddi-list li.ddi-sep { border-bottom: 1px solid var(--border); margin-bottom: 4px; padding-bottom: 10px; }
  .ddi-list li:hover, .ddi-list li:focus, .ddi-list li[aria-selected="true"] { background: var(--surface-alt); outline: none; }
  .ddi-list li[hidden] { display: none; }
  .ddi-code { color: var(--ink-muted); font-variant-numeric: tabular-nums; }
  .ddi-none { margin: 8px 10px; font-size: .88rem; color: var(--ink-muted); }
  @media (prefers-reduced-motion: reduce) { .qf-step { animation: none; } }
</style>

<script>
  import { leadStart, leadUpdate, leadComplete } from '../lib/api';

  const norm = (v: string) => v.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/\s+/g, ' ').trim();
  type Saved = { id: number; token: string; step: number; name?: string };
  const KEY = 'seven_lead';
  const save = (v: Saved) => { try { sessionStorage.setItem(KEY, JSON.stringify(v)); } catch {} };
  const load = (): Saved | null => {
    try {
      // Link do e-mail automático: ?lead=ID&t=TOKEN retoma a partir do WhatsApp.
      const qs = new URLSearchParams(location.search);
      const id = Number(qs.get('lead')), token = qs.get('t');
      if (id && token) { const v = { id, token, step: 3 }; save(v); return v; }
      return JSON.parse(sessionStorage.getItem(KEY) || 'null');
    } catch { return null; }
  };

  const root = document.querySelector<HTMLElement>('[data-qf]');
  if (root) {
    const total = Number(root.dataset.total);
    const steps = Array.from(root.querySelectorAll<HTMLElement>('[data-qf-step]'));
    const bar = root.querySelector<HTMLElement>('[data-qf-bar]')!;
    const nav = root.querySelector<HTMLElement>('[data-qf-nav]')!;
    let lead = load();
    let current = 1;
    const answers: Record<string, string> = {};

    function go(n: number) {
      current = Math.max(1, Math.min(n, total + 1));
      steps.forEach((s) => (s.hidden = Number(s.dataset.qfStep) !== current));
      bar.style.width = `${Math.min(current - 1, total) / total * 100}%`;
      // Depois de criado o lead não se volta ao nome/e-mail (já foram gravados).
      nav.hidden = current <= 1 || current > total || (current === 3 && !!lead);
      root!.querySelectorAll<HTMLElement>('[data-qf-msg]').forEach((m) => (m.hidden = true));
      const step = steps[current - 1];
      (step?.querySelector<HTMLElement>('.qf-input') ?? step?.querySelector<HTMLElement>('.qf-opt[aria-checked="true"], .qf-opt'))?.focus({ preventScroll: true });
      if (lead && current >= 3 && current <= total) save({ ...lead, step: current });
    }
    const fail = (form: HTMLElement, text?: string) => { const m = form.querySelector<HTMLElement>('[data-qf-msg]'); if (m) { m.textContent = text || ''; m.hidden = false; } };
    const busy = (form: HTMLElement, on: boolean) => form.querySelectorAll<HTMLButtonElement>('button').forEach((b) => (b.disabled = on));
    root.querySelector('[data-qf-back]')!.addEventListener('click', () => go(current - 1));
    go(lead ? Math.max(3, lead.step || 3) : 1);

    // 1. Nome
    const f1 = steps[0] as HTMLFormElement;
    f1.addEventListener('submit', (e) => {
      e.preventDefault();
      const fd = new FormData(f1);
      if (fd.get('company')) return;
      const name = String(fd.get('name') || '').trim();
      if (name.length < 2) return fail(f1, root.dataset.required);
      answers.name = name;
      const q = root.querySelector<HTMLElement>('[data-qf-email-q]')!;
      q.textContent = (q.dataset.tpl || '').replace('{name}', name.split(/\s+/)[0]);
      go(2);
    });

    // 2. E-mail: cria o lead
    const f2 = steps[1] as HTMLFormElement;
    f2.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(f2);
      const email = String(fd.get('email') || '').trim();
      if (!/^\S+@\S+\.\S+$/.test(email)) return fail(f2, root.dataset.invalidEmail);
      busy(f2, true);
      try {
        const lang = root.dataset.lang || 'pt';
        const r = await leadStart({
          name: answers.name, email, consent: fd.get('consent') === '1',
          site_lang: lang, language: lang === 'fr' ? 'en' : lang,
          page: location.pathname, turnstile_token: String(fd.get('cf-turnstile-response') || ''),
        });
        lead = { id: r.lead_id, token: r.token, step: 3 };
        // Conversão "Contato" do Google Ads: contato recebido.
        (window as any).gtag?.('event', 'conversion', { send_to: 'AW-10789023252/z_q5CP3zn48YEJTczZgo' });
        go(3);
      } catch { fail(f2, root.dataset.error); }
      finally { busy(f2, false); }
    });

    // Grava uma resposta e avança. Se a gravação falhar, mostra o erro e fica na pergunta.
    async function saveAnswer(form: HTMLElement, data: Record<string, string>, next: number) {
      if (!lead) return go(1);
      busy(form, true);
      try { await leadUpdate({ lead_id: lead.id, token: lead.token, ...data }); go(next); }
      catch { fail(form, root!.dataset.error); }
      finally { busy(form, false); }
    }

    // 3. WhatsApp
    const f3 = steps[2] as HTMLFormElement;
    f3.addEventListener('submit', (e) => {
      e.preventDefault();
      const fd = new FormData(f3);
      const digits = String(fd.get('phone') || '').replace(/\D/g, '');
      if (digits.length < 6) return fail(f3, root.dataset.invalidPhone);
      saveAnswer(f3, { phone: `${fd.get('ddi')} ${digits}` }, 4);
    });

    // 4 a 7. Escolhas (clique ou letra do teclado)
    root.querySelectorAll<HTMLFormElement>('[data-qf-choice]').forEach((form) => {
      const field = form.dataset.qfChoice!;
      const n = Number(form.dataset.qfStep);
      const opts = Array.from(form.querySelectorAll<HTMLButtonElement>('.qf-opt'));
      const choose = (b: HTMLButtonElement) => {
        opts.forEach((o) => o.setAttribute('aria-checked', String(o === b)));
        setTimeout(() => saveAnswer(form, { [field]: b.dataset.value! }, n + 1), 180);
      };
      opts.forEach((b) => b.addEventListener('click', () => choose(b)));
      form.addEventListener('submit', (e) => e.preventDefault());
      document.addEventListener('keydown', (e) => {
        if (current !== n || e.metaKey || e.ctrlKey || e.altKey) return;
        const b = opts.find((o) => o.dataset.key === e.key.toUpperCase());
        if (b) { e.preventDefault(); choose(b); }
      });
    });

    // 8. Caso (opcional): conclui
    const fLast = steps[total - 1] as HTMLFormElement;
    const area = fLast.querySelector<HTMLTextAreaElement>('textarea')!;
    area.addEventListener('keydown', (e) => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); fLast.requestSubmit(); } });
    fLast.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!lead) return go(1);
      busy(fLast, true);
      try {
        await leadComplete({ lead_id: lead.id, token: lead.token, message: area.value.trim() });
        try { sessionStorage.removeItem(KEY); } catch {}
        lead = null;
        go(total + 1);
      } catch { fail(fLast, root.dataset.error); }
      finally { busy(fLast, false); }
    });

    // --- Seletor de DDI pesquisável ---
    const ddi = root.querySelector<HTMLElement>('[data-ddi]')!;
    const ddiBtn = ddi.querySelector<HTMLButtonElement>('[data-ddi-btn]')!;
    const ddiPop = ddi.querySelector<HTMLElement>('[data-ddi-pop]')!;
    const ddiSearch = ddi.querySelector<HTMLInputElement>('[data-ddi-search]')!;
    const ddiNone = ddi.querySelector<HTMLElement>('[data-ddi-none]')!;
    const ddiValue = ddi.querySelector<HTMLInputElement>('[data-ddi-value]')!;
    const opts = Array.from(ddi.querySelectorAll<HTMLElement>('[data-ddi-list] li'));
    const setDdi = (li?: HTMLElement) => {
      if (!li) return;
      opts.forEach((o) => o.setAttribute('aria-selected', String(o === li)));
      ddiValue.value = li.dataset.dial || '';
      ddi.querySelector('[data-ddi-label]')!.textContent = li.dataset.dial || '';
      ddi.querySelector('[data-ddi-iso]')!.textContent = li.dataset.iso || '';
    };
    const filter = (q: string) => {
      const nq = norm(q); const digits = q.replace(/[^\d]/g, ''); let shown = 0;
      for (const o of opts) {
        const ok = !nq || norm(o.dataset.q || '').includes(nq) || (digits.length > 0 && (o.dataset.dial || '').replace('+', '').startsWith(digits));
        o.hidden = !ok; if (ok) shown++;
      }
      ddiNone.hidden = shown > 0;
    };
    const openDdi = (open: boolean) => { ddiPop.hidden = !open; ddiBtn.setAttribute('aria-expanded', String(open)); if (open) { ddiSearch.value = ''; filter(''); ddiSearch.focus(); } };
    const pickDdi = (o?: HTMLElement) => { setDdi(o); openDdi(false); ddiBtn.focus(); };
    ddiBtn.addEventListener('click', () => openDdi(ddiPop.hidden));
    ddiSearch.addEventListener('input', () => filter(ddiSearch.value));
    ddiSearch.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') { e.preventDefault(); pickDdi(opts.find((o) => !o.hidden)); }
      if (e.key === 'ArrowDown') { e.preventDefault(); opts.find((o) => !o.hidden)?.focus(); }
      if (e.key === 'Escape') { e.stopPropagation(); openDdi(false); ddiBtn.focus(); }
    });
    opts.forEach((o) => {
      o.addEventListener('click', () => pickDdi(o));
      o.addEventListener('keydown', (e) => {
        const vis = opts.filter((x) => !x.hidden); const i = vis.indexOf(o);
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); pickDdi(o); }
        if (e.key === 'ArrowDown') { e.preventDefault(); vis[i + 1]?.focus(); }
        if (e.key === 'ArrowUp') { e.preventDefault(); (vis[i - 1] ?? ddiSearch).focus(); }
        if (e.key === 'Escape') { e.stopPropagation(); openDdi(false); ddiBtn.focus(); }
      });
    });
    document.addEventListener('click', (e) => { if (!ddi.contains(e.target as Node)) openDdi(false); });
  }
</script>
