---
// Os botões "Falar com especialista" ([data-open-attendance]) levam à página do formulário em tela cheia.
import { getRoute, type Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
---
<div hidden data-attendance-href={getRoute('expert', lang)}></div>

<script>
  const href = document.querySelector<HTMLElement>('[data-attendance-href]')?.dataset.attendanceHref || '/falar-com-especialista';
  const open = () => { location.href = href; };
  window.addEventListener('seven:open-attendance', open);
  document.addEventListener('click', (e) => {
    if ((e.target as HTMLElement)?.closest('[data-open-attendance]')) { e.preventDefault(); open(); }
  });
</script>
