---
import { useTranslations, getRoute, type Lang } from '../../i18n/ui';
import { getUi } from '../../data/ui';
import { aboutCopy, brandCopy } from '../../data/about-copy';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const u = getUi(lang);
const copy = aboutCopy(lang);
const brand = brandCopy(lang);
const L = {
  pt: { more: 'Conheça mais', cards: [['values', 'Missão e valores', 'No que a gente acredita, o manifesto e como a gente trabalha.'], ['team', 'Equipe', 'As pessoas que vão cuidar do seu caso.'], ['units', 'Unidades', 'Albufeira, Faro e Porto, e online no mundo todo.']] },
  en: { more: 'Learn more', cards: [['values', 'Mission and values', 'What we believe, our manifesto and how we work.'], ['team', 'Team', 'The people who will take care of your case.'], ['units', 'Locations', 'Albufeira, Faro and Porto, and online worldwide.']] },
  es: { more: 'Conoce más', cards: [['values', 'Misión y valores', 'En qué creemos, nuestro manifiesto y cómo trabajamos.'], ['team', 'Equipo', 'Las personas que van a cuidar de tu caso.'], ['units', 'Sedes', 'Albufeira, Faro y Oporto, y online en todo el mundo.']] },
  fr: { more: 'En savoir plus', cards: [['values', 'Mission et valeurs', 'Ce en quoi nous croyons, notre manifeste et notre façon de travailler.'], ['team', 'Équipe', 'Les personnes qui s’occuperont de votre dossier.'], ['units', 'Agences', 'Albufeira, Faro et Porto, et en ligne partout dans le monde.']] },
}[lang] as { more: string; cards: [string, string, string][] };
---
<section class="pg-hero pg-hero--compact">
  <div class="container">
    <span class="eyebrow">{copy.title}</span>
    <h1>{brand.storyTitle}</h1>
    <p class="lede">{copy.intro}</p>
  </div>
  <div class="pg-hero-mark" aria-hidden="true"></div>
</section>

<section class="bg-white">
  <div class="container story-wrap">
    <figure class="founder-portrait">
      <img src="/team/danilo-sobre.jpg" alt={`Danilo Jesus — ${t('founder.role')}`} loading="lazy" width="760" height="1140" />
      <figcaption>Danilo Jesus · {t('founder.role')}</figcaption>
    </figure>
    <div class="story" lang={lang === 'pt' ? 'pt-BR' : lang}>
      {copy.story.map((p) => <p>{p}</p>)}
    </div>
  </div>
</section>

<section class="manifesto-strip">
  <div class="container">
    <p>{brand.manifesto[2]} <strong>{brand.manifestoClose}</strong></p>
  </div>
</section>

<section class="bg-off">
  <div class="container">
    <div class="sec-head"><span class="eyebrow">{L.more}</span></div>
    <div class="link-cards">
      {L.cards.map(([key, title, body]) => (
        <a href={getRoute(key as any, lang)} class="link-card"><h3>{title}</h3><p>{body}</p><span class="go">{u.common.learnMore}</span></a>
      ))}
    </div>
  </div>
</section>

<section class="sign-band sign-band--compact">
  <div class="container">
    <h2>{brand.closingTitle}</h2>
    <p>{brand.closingBody}</p>
    <div class="ctas">
      <a href={getRoute('expert', lang)} class="btn btn-gold">{u.common.talkToExpert}</a>
      <a href={getRoute('booking', lang)} class="btn btn-ghost">{u.common.bookConsult}</a>
    </div>
  </div>
</section>

<style>
  .story-wrap { display: grid; grid-template-columns: 1fr 280px; gap: clamp(28px, 5vw, 56px); align-items: start; max-width: 1040px; }
  .story p { font-size: 1.05rem; line-height: 1.8; color: var(--ink); text-align: justify; hyphens: auto; -webkit-hyphens: auto; }
  .story p + p { margin-top: 1em; }
  .founder-portrait { order: 2; position: sticky; top: 110px; }
  .founder-portrait img { width: 100%; height: auto; display: block; }
  .founder-portrait figcaption { margin-top: 10px; font-family: var(--font-head); font-size: .76rem; text-transform: uppercase; letter-spacing: .12em; color: var(--ink-muted); text-align: center; }
  .manifesto-strip { background: var(--surface-warm, var(--surface-alt)); padding: clamp(28px, 4vw, 40px) 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .manifesto-strip p { font-family: var(--font-head); font-weight: 600; font-size: clamp(1.15rem, 2.2vw, 1.5rem); color: var(--heading); text-align: center; text-wrap: balance; }
  .manifesto-strip strong { display: block; margin-top: 6px; text-transform: uppercase; letter-spacing: .04em; color: var(--heading); }
  .sign-band--compact { padding: clamp(40px, 6vw, 64px) 0; }
  .sign-band--compact h2 { margin-top: 0; }
  @media (max-width: 760px) { .story-wrap { grid-template-columns: 1fr; } .founder-portrait { order: 0; position: static; width: 220px; margin: 0 auto; } .story p { text-align: left; } }
</style>
