---
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props { lang: Lang; kind: 'terms' | 'privacy'; }
const { lang, kind } = Astro.props;
const t = useTranslations(lang);
const title = kind === 'terms' ? t('footer.terms') : t('footer.privacy');

const draftNote = {
  pt: 'Texto preliminar — versão final em revisão jurídica.',
  en: 'Preliminary text — final version under legal review.',
  es: 'Texto preliminar — versión final en revisión jurídica.',
  fr: 'Texte provisoire — version finale en cours de révision juridique.',
}[lang];

// ---------------------------------------------------------------------------
// Privacy Policy (with Cookies section)
// Strings in `p` and `ul` are trusted static content and may contain simple
// inline HTML (<strong>, <a>, <code>); they are rendered with set:html.
// ---------------------------------------------------------------------------
interface PolicySection { id?: string; h: string; p?: string[]; ul?: string[]; after?: string[]; }
interface Policy { reviewNote: string; updated: string; intro: string[]; sections: PolicySection[]; }

const EMAIL = 'albufeira@sevenservicess.com';
const mail = `<a href="mailto:${EMAIL}">${EMAIL}</a>`;
const cnpd = '<a href="https://www.cnpd.pt" target="_blank" rel="noopener">www.cnpd.pt</a>';

const privacy: Record<Lang, Policy> = {
  pt: {
    reviewNote: 'Versão em revisão pela nossa advogada.',
    updated: 'Última atualização: 12 de outubro de 2026.',
    intro: [
      'Esta Política de Privacidade explica, de forma simples, quais dados pessoais a SEVEN recolhe através deste site, para que os usa, com quem os partilha e quais são os seus direitos. Ela segue o Regulamento Geral sobre a Proteção de Dados (RGPD) e a legislação portuguesa aplicável.',
    ],
    sections: [
      {
        h: '1. Quem é o responsável pelos seus dados',
        p: [
          'O responsável pelo tratamento é a <strong>SANTOS JESUS Unipessoal Lda</strong>, NIPC 518 146 529, que opera com a marca <strong>SEVEN</strong>, com sede na Rua do MFA, 111 G, 8200-157 Albufeira, Portugal.',
          'A SEVEN presta serviços de imigração, documentação, constituição de empresas e apoio contabilístico em Portugal, além de serviços consulares brasileiros online para clientes em qualquer país. Temos escritórios em Albufeira, Faro e Porto.',
          `Para qualquer questão sobre privacidade, escreva para ${mail}.`,
        ],
      },
      {
        h: '2. Que dados recolhemos',
        ul: [
          '<strong>Formulário “Falar com especialista”:</strong> nome, e-mail, telefone/WhatsApp com indicativo do país, escritório preferido, idioma, mensagem e, se você marcar a opção, a autorização para contacto por WhatsApp.',
          '<strong>Formulário de agendamento:</strong> nome, e-mail, telefone, horário escolhido e idioma. O pagamento é processado pela Stripe; a SEVEN não recebe nem guarda os dados do seu cartão.',
          '<strong>Dados técnicos e cookies:</strong> informações do navegador e de utilização do site, conforme descrito na secção de cookies abaixo.',
        ],
        after: [
          'Se você se tornar cliente, tratamos também os dados e documentos necessários para prestar o serviço contratado.',
        ],
      },
      {
        h: '3. Para que usamos os dados e com que base legal',
        ul: [
          '<strong>Responder ao seu pedido</strong> e tomar as diligências pré-contratuais que você solicitou (art. 6.º, n.º 1, al. b) do RGPD).',
          '<strong>Contacto por WhatsApp</strong>, incluindo mensagens de acompanhamento e lembretes, apenas com o seu consentimento (art. 6.º, n.º 1, al. a)). Você pode retirá-lo a qualquer momento, respondendo à mensagem ou escrevendo para o nosso e-mail.',
          '<strong>Execução do contrato e cumprimento de obrigações legais e fiscais</strong>, no caso de clientes (art. 6.º, n.º 1, als. b) e c)).',
          '<strong>Cookies de análise e de publicidade</strong>, apenas com o seu consentimento (art. 6.º, n.º 1, al. a)).',
          '<strong>Proteção contra spam</strong> nos formulários, com o Cloudflare Turnstile, com base no nosso interesse legítimo em manter o site seguro (art. 6.º, n.º 1, al. f)).',
        ],
      },
      {
        h: '4. Com quem partilhamos os dados',
        p: ['Não vendemos os seus dados. Recorremos a prestadores de serviços que tratam dados em nosso nome:'],
        ul: [
          '<strong>Supabase</strong> — base de dados e funções de servidor, alojados na UE (região da Irlanda).',
          '<strong>Kommo</strong> — CRM onde registamos os pedidos de contacto.',
          '<strong>Stripe</strong> — processamento de pagamentos.',
          '<strong>Google</strong> — Google Analytics e Google Ads, apenas com consentimento (usamos o Google Consent Mode).',
          '<strong>Meta</strong> — pixel do Facebook/Instagram, apenas com consentimento, se e quando for ativado.',
          '<strong>Cloudflare</strong> — Turnstile, proteção antispam.',
          '<strong>GitHub Pages</strong> — alojamento do site.',
          '<strong>WhatsApp (Meta)</strong> — troca de mensagens.',
        ],
      },
      {
        h: '5. Transferências para fora do Espaço Económico Europeu',
        p: [
          'Alguns destes prestadores podem transferir dados para fora do EEE. Nesses casos, as transferências são feitas ao abrigo do Quadro de Privacidade de Dados UE–EUA (Data Privacy Framework) ou de Cláusulas Contratuais-Tipo aprovadas pela Comissão Europeia.',
        ],
      },
      {
        h: '6. Durante quanto tempo guardamos os dados',
        ul: [
          '<strong>Pedidos de contacto que não se tornam clientes:</strong> até 24 meses após o último contacto; depois são apagados.',
          '<strong>Dados de clientes:</strong> durante a prestação do serviço e, depois, pelos prazos exigidos pela legislação fiscal e contabilística portuguesa (em geral, 10 anos para documentos contabilísticos).',
          '<strong>Registos de consentimento:</strong> enquanto o consentimento for válido e pelo tempo necessário para o comprovar.',
        ],
      },
      {
        id: 'cookies',
        h: '7. Cookies',
        p: ['Usamos cookies e tecnologias semelhantes em três categorias:'],
        ul: [
          '<strong>Estritamente necessários</strong> (sempre ativos): guardam a sua escolha de cookies no armazenamento local do navegador (localStorage), na chave <code>seven_consent</code>, e permitem a proteção antispam do Cloudflare Turnstile.',
          '<strong>Análise</strong> (apenas com consentimento): Google Analytics 4 (ID G-QQBZL8K18D), com cookies como <code>_ga</code> e <code>_ga_*</code>, para percebermos como o site é usado.',
          '<strong>Marketing</strong> (apenas com consentimento): Google Ads (AW-10789023252), para medir conversões, e Meta Pixel, quando ativado, com cookies como <code>_gcl_*</code> e <code>_fbp</code>.',
        ],
        after: [
          'Você pode mudar a sua escolha a qualquer momento no link <strong>“Preferências de cookies”</strong>, no rodapé do site.',
        ],
      },
      {
        h: '8. Os seus direitos',
        p: ['Nos termos do RGPD, você tem direito a:'],
        ul: [
          'aceder aos seus dados;',
          'corrigir dados incorretos ou incompletos;',
          'pedir o apagamento dos dados;',
          'limitar o tratamento;',
          'receber os seus dados num formato portátil;',
          'opor-se ao tratamento;',
          'retirar o consentimento a qualquer momento, sem afetar o tratamento feito antes.',
        ],
        after: [
          `Para exercer estes direitos, escreva para ${mail}. Você também pode apresentar reclamação à autoridade de controlo portuguesa, a CNPD — Comissão Nacional de Proteção de Dados (${cnpd}).`,
        ],
      },
      {
        h: '9. Menores',
        p: [
          'Os nossos serviços não se destinam a crianças. Dados de menores (por exemplo, para passaportes ou registos de filhos) só são tratados quando fornecidos pelos pais ou representantes legais, no âmbito de um serviço que eles solicitaram.',
        ],
      },
      {
        h: '10. Alterações e contacto',
        p: [
          `Podemos atualizar esta política sempre que necessário; a data da última atualização fica indicada no topo. Dúvidas? Fale com a gente: ${mail}.`,
        ],
      },
    ],
  },

  en: {
    reviewNote: 'This version is being reviewed by our lawyer.',
    updated: 'Last updated: 12 October 2026.',
    intro: [
      'This Privacy Policy explains, in plain terms, what personal data SEVEN collects through this website, what we use it for, who we share it with and what your rights are. It follows the General Data Protection Regulation (GDPR) and applicable Portuguese law.',
    ],
    sections: [
      {
        h: '1. Who is responsible for your data',
        p: [
          'The data controller is <strong>SANTOS JESUS Unipessoal Lda</strong>, NIPC 518 146 529, trading as <strong>SEVEN</strong>, registered at Rua do MFA, 111 G, 8200-157 Albufeira, Portugal.',
          'SEVEN provides immigration, documentation, company formation and accounting support in Portugal, as well as online Brazilian consular services for clients anywhere in the world. We have offices in Albufeira, Faro and Porto.',
          `For any privacy question, email ${mail}.`,
        ],
      },
      {
        h: '2. What data we collect',
        ul: [
          '<strong>“Talk to a specialist” form:</strong> name, email, WhatsApp phone number with country code, preferred office, language, message and, if you tick the box, your permission to contact you via WhatsApp.',
          '<strong>Booking form:</strong> name, email, phone, chosen time slot and language. Payment is processed by Stripe; SEVEN does not receive or store your card details.',
          '<strong>Technical data and cookies:</strong> browser and site usage information, as described in the cookies section below.',
        ],
        after: [
          'If you become a client, we also process the data and documents needed to deliver the service you have engaged us for.',
        ],
      },
      {
        h: '3. Why we use your data and on what legal basis',
        ul: [
          '<strong>Answering your request</strong> and taking the pre-contractual steps you asked for (Art. 6(1)(b) GDPR).',
          '<strong>Contact via WhatsApp</strong>, including follow-up and reminder messages, only with your consent (Art. 6(1)(a)). You can withdraw it at any time by replying to the message or emailing us.',
          '<strong>Performing the contract and meeting legal and tax obligations</strong> for clients (Art. 6(1)(b) and (c)).',
          '<strong>Analytics and advertising cookies</strong>, only with your consent (Art. 6(1)(a)).',
          '<strong>Spam protection</strong> on our forms with Cloudflare Turnstile, based on our legitimate interest in keeping the site secure (Art. 6(1)(f)).',
        ],
      },
      {
        h: '4. Who we share your data with',
        p: ['We do not sell your data. We use service providers that process data on our behalf:'],
        ul: [
          '<strong>Supabase</strong> — database and server functions, hosted in the EU (Ireland region).',
          '<strong>Kommo</strong> — CRM where contact requests are recorded.',
          '<strong>Stripe</strong> — payment processing.',
          '<strong>Google</strong> — Google Analytics and Google Ads, only with consent (we use Google Consent Mode).',
          '<strong>Meta</strong> — Facebook/Instagram pixel, only with consent, if and when activated.',
          '<strong>Cloudflare</strong> — Turnstile anti-spam protection.',
          '<strong>GitHub Pages</strong> — website hosting.',
          '<strong>WhatsApp (Meta)</strong> — messaging.',
        ],
      },
      {
        h: '5. Transfers outside the European Economic Area',
        p: [
          'Some of these providers may transfer data outside the EEA. Where they do, transfers rely on the EU–US Data Privacy Framework or on Standard Contractual Clauses approved by the European Commission.',
        ],
      },
      {
        h: '6. How long we keep your data',
        ul: [
          '<strong>Contact requests that do not become clients:</strong> up to 24 months after the last contact, then deleted.',
          '<strong>Client data:</strong> for the duration of the service and then for the periods required by Portuguese tax and accounting law (generally 10 years for accounting documents).',
          '<strong>Consent records:</strong> while the consent is valid and for as long as needed to prove it.',
        ],
      },
      {
        id: 'cookies',
        h: '7. Cookies',
        p: ['We use cookies and similar technologies in three categories:'],
        ul: [
          '<strong>Strictly necessary</strong> (always on): store your cookie choice in your browser’s local storage (localStorage) under the key <code>seven_consent</code>, and enable Cloudflare Turnstile spam protection.',
          '<strong>Analytics</strong> (only with consent): Google Analytics 4 (ID G-QQBZL8K18D), with cookies such as <code>_ga</code> and <code>_ga_*</code>, so we can understand how the site is used.',
          '<strong>Marketing</strong> (only with consent): Google Ads (AW-10789023252) for conversion measurement, and the Meta Pixel when activated, with cookies such as <code>_gcl_*</code> and <code>_fbp</code>.',
        ],
        after: [
          'You can change your choice at any time using the <strong>“Cookie preferences”</strong> link in the site footer.',
        ],
      },
      {
        h: '8. Your rights',
        p: ['Under the GDPR, you have the right to:'],
        ul: [
          'access your data;',
          'have inaccurate or incomplete data rectified;',
          'have your data erased;',
          'restrict processing;',
          'receive your data in a portable format;',
          'object to processing;',
          'withdraw your consent at any time, without affecting processing carried out before.',
        ],
        after: [
          `To exercise these rights, email ${mail}. You can also lodge a complaint with the Portuguese supervisory authority, the CNPD — Comissão Nacional de Proteção de Dados (${cnpd}).`,
        ],
      },
      {
        h: '9. Children',
        p: [
          'Our services are not directed at children. Data about minors (for example, for children’s passports or registrations) is only processed when provided by parents or legal guardians as part of a service they have requested.',
        ],
      },
      {
        h: '10. Changes and contact',
        p: [
          `We may update this policy when needed; the date of the latest update is shown at the top. Any questions? Get in touch: ${mail}.`,
        ],
      },
    ],
  },

  es: {
    reviewNote: 'Versión en revisión por nuestra abogada.',
    updated: 'Última actualización: 12 de octubre de 2026.',
    intro: [
      'Esta Política de Privacidad te explica, de forma sencilla, qué datos personales recoge SEVEN a través de este sitio web, para qué los usa, con quién los comparte y cuáles son tus derechos. Se rige por el Reglamento General de Protección de Datos (RGPD) y la legislación portuguesa aplicable.',
    ],
    sections: [
      {
        h: '1. Quién es el responsable de tus datos',
        p: [
          'El responsable del tratamiento es <strong>SANTOS JESUS Unipessoal Lda</strong>, NIPC 518 146 529, que opera con la marca <strong>SEVEN</strong>, con domicilio en Rua do MFA, 111 G, 8200-157 Albufeira, Portugal.',
          'SEVEN presta servicios de inmigración, documentación, constitución de empresas y apoyo contable en Portugal, además de servicios consulares brasileños en línea para clientes de cualquier país. Tenemos oficinas en Albufeira, Faro y Oporto.',
          `Para cualquier consulta sobre privacidad, escríbenos a ${mail}.`,
        ],
      },
      {
        h: '2. Qué datos recogemos',
        ul: [
          '<strong>Formulario “Hablar con un especialista”:</strong> nombre, correo electrónico, teléfono de WhatsApp con prefijo del país, oficina preferida, idioma, mensaje y, si marcas la casilla, tu autorización para contactarte por WhatsApp.',
          '<strong>Formulario de reserva:</strong> nombre, correo electrónico, teléfono, horario elegido e idioma. El pago lo procesa Stripe; SEVEN no recibe ni guarda los datos de tu tarjeta.',
