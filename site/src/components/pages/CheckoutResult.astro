---
import { getRoute, type Lang } from '../../i18n/ui';

interface Props { lang: Lang; kind: 'success' | 'cancel'; }
const { lang, kind } = Astro.props;

const copy = {
  pt: {
    successTitle: 'Pagamento recebido',
    successBody: 'Obrigado. A gente enviou a confirmação para o seu e-mail. Se você pagou por Multibanco, que funciona como um boleto, a confirmação pode levar um pouco mais.',
    cancelTitle: 'Pagamento cancelado',
    cancelBody: 'Nenhum valor foi cobrado. Você pode tentar de novo quando quiser.',
    home: 'Voltar ao início', contact: 'Falar com a equipe',
  },
  en: {
    successTitle: 'Payment received',
    successBody: 'Thank you. We have sent the confirmation to your email. If you paid by Multibanco, a Portuguese payment reference system, the confirmation may take a little longer.',
    cancelTitle: 'Payment cancelled',
    cancelBody: 'You have not been charged. You can try again whenever you like.',
    home: 'Back to home', contact: 'Talk to the team',
  },
  es: {
    successTitle: 'Pago recibido',
    successBody: 'Gracias. Te enviamos la confirmación a tu correo electrónico. Si pagaste por Multibanco, un sistema portugués de pago por referencia, la confirmación puede tardar un poco más.',
    cancelTitle: 'Pago cancelado',
    cancelBody: 'No se cobró ningún importe. Puedes intentarlo de nuevo cuando quieras.',
    home: 'Volver al inicio', contact: 'Hablar con el equipo',
  },
  fr: {
    successTitle: 'Paiement reçu',
    successBody: 'Merci. Nous avons envoyé la confirmation à votre adresse e-mail. Si vous avez payé par Multibanco, un système portugais de paiement par référence, la confirmation peut prendre un peu plus de temps.',
    cancelTitle: 'Paiement annulé',
    cancelBody: 'Aucun montant n’a été débité. Vous pouvez réessayer quand vous le souhaitez.',
    home: 'Retour à l’accueil', contact: 'Parler à l’équipe',
  },
}[lang];

const isSuccess = kind === 'success';
---
<section class="bg-navy" style="min-height:60vh;display:flex;align-items:center">
  <div class="container center" style="max-width:600px">
    <div class="result-icon">{isSuccess ? '✓' : '✕'}</div>
    <h1>{isSuccess ? copy.successTitle : copy.cancelTitle}</h1>
    <p class="lead" style="margin-inline:auto">{isSuccess ? copy.successBody : copy.cancelBody}</p>
    <div style="margin-top:26px;display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
      <a href={getRoute('home', lang)} class="btn btn-gold">{copy.home}</a>
      {!isSuccess && <a href={getRoute('contact', lang)} class="btn btn-light">{copy.contact}</a>}
    </div>
  </div>
</section>

<style>
  .result-icon {
    width: 76px; height: 76px; border-radius: 50%; margin: 0 auto 20px;
    display: flex; align-items: center; justify-content: center; font-size: 2.2rem; font-weight: 700;
    background: var(--g1); color: var(--n1);
  }
</style>
