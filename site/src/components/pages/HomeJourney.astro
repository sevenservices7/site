---
// Home contada como jornada (decidir → chegar → morar → ser português → empreender), em todos os idiomas.
// Blog, podcast e depoimentos só existem em português e só aparecem na versão PT.
import { getCollection } from 'astro:content';
import { getOffices } from '../../lib/data';
import { STAGES, solutionsByStageFor, solutionFor, solutionPath } from '../../data/solucoes';
import { getUi } from '../../data/ui';
import { getRoute, type Lang } from '../../i18n/ui';
import { mainWhatsapp, waText } from '../../lib/site';
import UnitCard from '../UnitCard.astro';
import TrustBadges from '../TrustBadges.astro';
import WhatsAppButton from '../WhatsAppButton.astro';

interface Props { lang?: Lang; }
const { lang = 'pt' } = Astro.props;
const isPt = lang === 'pt';
const u = getUi(lang);
const h = u.home;
const booking = getRoute('booking', lang);
const hub = getRoute('solutions', lang);
const offices = await getOffices();
const wa = await mainWhatsapp();
const journey = STAGES.filter((s) => s.id !== 'apoio').map((s) => ({ ...s, ...u.stages[s.id], items: solutionsByStageFor(lang, s.id) }));
const bizLinks = ['abrir-empresa-em-portugal', 'contabilidade-em-portugal'].map((k) => solutionFor(lang, k));

const byDate = <T extends { data: { pubDate: Date } }>(a: T, b: T) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
const posts = isPt ? (await getCollection('blog', ({ data }) => !data.draft)).sort(byDate).slice(0, 3) : [];
const episodes = isPt ? (await getCollection('podcast', ({ data }) => !data.draft)).sort(byDate).slice(0, 2) : [];
const dateFmt = new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' });


// Palavras dos clientes, sem edição.
const testimonials = [
  { q: 'Em três semanas tinha o NIF, a morada fiscal e o pedido de residência submetido. Nunca pensei que pudesse ser tão simples.', who: 'Ana R. · Lisboa' },
  { q: 'O atendimento foi impecável. Resolveram pendências que me diziam serem complicadas, trataram de toda a documentação e deram suporte até à entrevista na AIMA. Confio totalmente na Seven.', who: 'Sara Silva' },
  { q: 'Cheguei em abril como turista. Em outubro tinha o título de residência na mão — fizeram tudo, do NIF ao título.', who: 'Eduardo Rodrigues' },
];
---
<section class="pg-hero home-hero">
  <div class="container">
    <span class="eyebrow">{h.eyebrow}</span>
    <h1>{h.h1} <em>{h.h1Em}</em></h1>
    <p class="lede">{h.lede}</p>
    <div class="ctas">
      <a href={booking} class="btn btn-gold">{u.common.talkToExpert}</a>
      <a href={hub} class="btn btn-light">{h.ctaSecondary}</a>
    </div>
    <div class="pg-highlights">
      {h.highlights.map((x) => <div><strong>{x.value}</strong><span>{x.label}</span></div>)}
    </div>
  </div>
  <div class="pg-hero-mark" aria-hidden="true"></div>
</section>

<!-- JORNADA -->
<section class="bg-white">
  <div class="container">
    <div class="sec-head">
      <span class="eyebrow">{h.journeyEyebrow}</span>
      <h2>{h.journeyTitle}</h2>
      <p class="lead">{h.journeyLead}</p>
    </div>
    <ol class="journey">
      {journey.map((st) => (
        <li class="journey-step">
          <span class="journey-n">{st.step}</span>
          <h3>{st.title}</h3>
          <p>{st.summary}</p>
          {st.items.length > 0 && (
            <ul>{st.items.map((it) => <li><a href={solutionPath(lang, it)}>{it.navLabel}</a></li>)}</ul>
          )}
        </li>
      ))}
    </ol>
    <p style="margin-top:28px"><a href={hub} class="btn btn-ghost">{u.common.seeAllSolutions}</a></p>
  </div>
</section>

<!-- JEITO SEVEN -->
<section class="bg-off">
  <div class="container home-split">
    <div class="sec-head">
      <span class="eyebrow">{h.wayEyebrow}</span>
      <h2>{h.wayTitle}</h2>
      <p class="lead">{h.wayLead}</p>
    </div>
    <ol class="steps-list">
      {h.principles.map(([n, ti, d]) => <li><span class="n">{n}</span><div><h3>{ti}</h3><p>{d}</p></div></li>)}
    </ol>
  </div>
</section>

<!-- EMPRESAS -->
<section class="bg-white">
  <div class="container">
    <div class="biz">
      <div class="biz-main">
        <span class="eyebrow">{h.bizEyebrow}</span>
        <h2>{h.bizTitle}</h2>
        <p class="lead">{h.bizLead}</p>
      </div>
      <div class="link-cards">
        {h.bizCards.map((c, i) => bizLinks[i] && (
          <a href={solutionPath(lang, bizLinks[i]!)} class="link-card"><h3>{c.title}</h3><p>{c.body}</p><span class="go">{u.common.learnMore}</span></a>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- DEPOIMENTOS (palavras dos clientes, em português: só na versão PT) -->
{isPt && <section class="testimonial">
  <div class="container">
    <div class="sec-head">
      <span class="eyebrow">{h.testimonialsEyebrow}</span>
      <h2>{h.testimonialsTitle}</h2>
    </div>
    <div class="tgrid">
      {testimonials.map((tm) => (
        <figure class="tcard"><blockquote>{tm.q}</blockquote><figcaption class="who">{tm.who}</figcaption></figure>
      ))}
    </div>
  </div>
</section>}

<!-- UNIDADES -->
<section id="unidades" class="bg-off">
  <div class="container">
    <div class="sec-head">
      <span class="eyebrow">{h.unitsEyebrow}</span>
      <h2>{h.unitsTitle}</h2>
      <p class="lead">{h.unitsLead}</p>
    </div>
    <div class="grid cols-3">
      {offices.map((o) => <UnitCard office={o} lang={lang} />)}
    </div>
  </div>
</section>

<!-- CONTEÚDO: PODCAST + BLOG (só PT) -->
{isPt && <section class="bg-white">
  <div class="container">
    <div class="cast">
      <div>
        <span class="eyebrow">Podcast</span>
        <h2>Vida real na Europa, sem filtro.</h2>
        <p class="lead">Conversas diretas sobre imigração, dinheiro e negócios em Portugal. Com transcrição completa de cada episódio.</p>
        <p style="margin-top:22px"><a href="/podcast" class="btn btn-ghost">Ver todos os episódios</a></p>
      </div>
      {episodes.length > 0 && (
        <div class="link-cards">
          {episodes.map((e) => (
            <a href={`/podcast/${e.id}`} class="link-card"><span class="meta-line">{e.data.episode !== undefined ? `Episódio ${String(e.data.episode).padStart(2, '0')}` : 'Episódio'}</span><h3>{e.data.title}</h3><p>{e.data.description}</p><span class="go">Assistir</span></a>
          ))}
        </div>
      )}
    </div>

    {posts.length > 0 && (
      <div style="margin-top:clamp(48px,7vw,80px)">
        <div class="sec-head">
          <span class="eyebrow">Blog</span>
          <h2>Explicado do jeito que você entende.</h2>
        </div>
        <div class="link-cards">
          {posts.map((p) => (
            <a href={`/blog/${p.id}`} class="link-card"><span class="meta-line">{dateFmt.format(p.data.pubDate)}</span><h3>{p.data.title}</h3><p>{p.data.description}</p><span class="go">Ler artigo</span></a>
          ))}
        </div>
      </div>
    )}
  </div>
</section>}

<section class="bg-off"><div class="container"><TrustBadges lang={lang} /></div></section>

<section class="sign-band">
  <div class="container">
    <p class="statement">{h.closingStatement}</p>
    <h2>{h.closingTitle}</h2>
    <p>{h.closingBody}</p>
    <div class="ctas">
      <a href={booking} class="btn btn-gold">{u.common.talkToExpert}</a>
      <WhatsAppButton whatsapp={wa} text={waText(undefined, lang)} label={u.common.whatsapp} />
    </div>
  </div>
</section>

<style>
  .home-hero h1 { font-size: clamp(2.6rem, 7vw, 5rem); text-transform: uppercase; max-width: 12ch; }
  .journey { list-style: none; display: grid; grid-template-columns: repeat(5, 1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); }
  .journey-step { background: var(--surface); padding: 24px 20px; display: flex; flex-direction: column; gap: 8px; }
  .journey-n { font-size: 28px; line-height: 36px; font-weight: 600; color: var(--heading); padding-bottom: 6px; border-bottom: 3px solid var(--accent); align-self: flex-start; }
  .journey-step h3 { margin-top: 8px; font-size: 1.1rem; text-transform: uppercase; letter-spacing: .02em; }
  .journey-step p { color: var(--ink-muted); font-size: .92rem; line-height: 1.55; }
  .journey-step ul { list-style: none; margin-top: auto; padding-top: 12px; display: flex; flex-direction: column; gap: 6px; }
  .journey-step ul a { font-size: .9rem; font-weight: 500; color: var(--heading); text-decoration: underline; text-decoration-color: var(--complementar-2); text-underline-offset: 3px; }
  .journey-step ul a:hover { text-decoration-color: var(--heading); }
  @media (max-width: 1000px) { .journey { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .journey { grid-template-columns: 1fr; } }

  .home-split { display: grid; grid-template-columns: 1fr 1.3fr; gap: clamp(32px, 5vw, 72px); align-items: start; }
  @media (max-width: 860px) { .home-split { grid-template-columns: 1fr; } }

  .biz { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 64px); align-items: center; }
  .biz-main h2 { font-size: clamp(1.7rem, 3.4vw, 2.5rem); margin-bottom: 14px; }
  .biz .link-cards { grid-template-columns: 1fr; }
  @media (max-width: 860px) { .biz { grid-template-columns: 1fr; } }

  .testimonial { background: var(--surface-brand); color: var(--nevoa); padding: clamp(64px, 9vw, 104px) 0; }
  .testimonial h2 { color: var(--branco); }
  .testimonial .eyebrow { color: var(--on-brand-muted); }
  .testimonial .eyebrow::before { background: var(--accent); }
  .tgrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .tcard { margin: 0; display: flex; flex-direction: column; gap: 18px; padding: 28px; background: var(--complementar-1); }
  .tcard blockquote { font-weight: 400; font-size: 1.05rem; line-height: 1.6; margin: 0; color: var(--nevoa); }
  .tcard blockquote::before { content: '“'; color: var(--accent); }
  .tcard blockquote::after { content: '”'; color: var(--accent); }
  .tcard .who { margin-top: auto; font-weight: 500; font-size: 13px; text-transform: uppercase; letter-spacing: 0.2em; color: var(--accent); }
  @media (max-width: 860px) { .tgrid { grid-template-columns: 1fr; } }

  .cast { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(32px, 5vw, 64px); align-items: start; }
  .cast h2 { font-size: clamp(1.7rem, 3.4vw, 2.5rem); }
  .cast .link-cards { grid-template-columns: 1fr; }
  @media (max-width: 860px) { .cast { grid-template-columns: 1fr; } }
</style>
