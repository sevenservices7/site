---
import { useTranslations, getRoute, type Lang } from '../../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);

const copy = {
  pt: { title: 'Agendar consultoria', step1: '2. Idioma da consultoria', step2: '3. Escolha o dia e o horário', step3: '4. Seus dados', noslots: 'Os horários online vão estar disponíveis em breve. Enquanto isso, fale com um especialista:', name: 'Nome completo', email: 'E-mail', phone: 'Celular', pay: 'Pagar e confirmar', loading: 'Carregando horários…', book: 'Reservar e pagar' },
  en: { title: 'Book a consultation', step1: '2. Consultation language', step2: '3. Choose a day and time', step3: '4. Your details', noslots: 'Online time slots will be available soon. In the meantime, talk to a specialist:', name: 'Full name', email: 'Email', phone: 'Mobile phone', pay: 'Pay and confirm', loading: 'Loading time slots…', book: 'Book and pay' },
  es: { title: 'Agendar consultoría', step1: '2. Idioma de la consultoría', step2: '3. Elige el día y la hora', step3: '4. Tus datos', noslots: 'Los horarios online estarán disponibles pronto. Mientras tanto, habla con un especialista:', name: 'Nombre completo', email: 'Correo electrónico', phone: 'Celular', pay: 'Pagar y confirmar', loading: 'Cargando horarios…', book: 'Reservar y pagar' },
  fr: { title: 'Prendre rendez-vous', step1: '2. Langue de la consultation', step2: '3. Choisissez le jour et l’heure', step3: '4. Vos coordonnées', noslots: 'Les créneaux en ligne seront bientôt disponibles. En attendant, parlez à un spécialiste :', name: 'Nom complet', email: 'E-mail', phone: 'Téléphone portable', pay: 'Payer et confirmer', loading: 'Chargement des créneaux…', book: 'Réserver et payer' },
}[lang];
// Área da consultoria (todas 80 €, descontados se o cliente seguir com o serviço).
const types = {
  pt: { title: '1. Que consultoria você precisa?', lede: 'Consultoria de 30 minutos com um especialista, online ou presencial: 80 €, descontados se você seguir com o serviço.', missing: 'Escolha a área da consultoria.', items: [['imigratoria', 'Imigratória', 'Vistos, residência, renovação, família e nacionalidade.'], ['contabil', 'Contábil', 'Empresa, trabalhador independente, IRS e impostos.'], ['juridica', 'Jurídica', 'Recursos, indeferimentos e casos complexos, com advogada.']] },
  en: { title: '1. Which consultation do you need?', lede: '30-minute consultation with a specialist, online or in person: €80, deducted if you go ahead with the service.', missing: 'Please choose the consultation area.', items: [['imigratoria', 'Immigration', 'Visas, residence, renewal, family and citizenship.'], ['contabil', 'Accounting', 'Company, self-employment, IRS and taxes.'], ['juridica', 'Legal', 'Appeals, refusals and complex cases, with our lawyer.']] },
  es: { title: '1. ¿Qué consultoría necesitas?', lede: 'Consultoría de 30 minutos con un especialista, online o presencial: 80 €, que se descuentan si sigues con el servicio.', missing: 'Elige el área de la consultoría.', items: [['imigratoria', 'Inmigración', 'Visados, residencia, renovación, familia y nacionalidad.'], ['contabil', 'Contable', 'Empresa, autónomos, IRS e impuestos.'], ['juridica', 'Jurídica', 'Recursos, denegaciones y casos complejos, con abogada.']] },
  fr: { title: '1. De quelle consultation avez-vous besoin ?', lede: 'Consultation de 30 minutes avec un spécialiste, en ligne ou sur place : 80 €, déduits si vous poursuivez avec le service.', missing: 'Choisissez le domaine de la consultation.', items: [['imigratoria', 'Immigration', 'Visas, titre de séjour, renouvellement, famille et nationalité.'], ['contabil', 'Comptabilité', 'Entreprise, indépendants, IRS et impôts.'], ['juridica', 'Juridique', 'Recours, refus et dossiers complexes, avec notre avocate.']] },
}[lang] as { title: string; lede: string; missing: string; items: [string, string, string][] };
// Consultas são feitas em PT/EN/ES; para FR, o idioma inicial sugerido é o inglês.
const consultLang = lang === 'fr' ? 'en' : lang;
const msgs = {
  pt: { err: 'Não deu para reservar. Tente de novo ou chame a gente no WhatsApp.', taken: 'Esse horário acabou de ser reservado. Escolha outro.', missing: 'Preencha nome, e-mail e celular para continuar.' },
  en: { err: 'We could not book it. Please try again or message us on WhatsApp.', taken: 'That time was just booked. Please choose another.', missing: 'Please fill in your name, email and phone to continue.' },
  es: { err: 'No se pudo reservar. Inténtalo de nuevo o escríbenos por WhatsApp.', taken: 'Ese horario acaba de reservarse. Elige otro.', missing: 'Completa nombre, correo y celular para continuar.' },
  fr: { err: 'La réservation n’a pas abouti. Réessayez ou écrivez-nous sur WhatsApp.', taken: 'Ce créneau vient d’être réservé. Choisissez-en un autre.', missing: 'Indiquez votre nom, e-mail et téléphone pour continuer.' },
}[lang];
const tzNote = { pt: 'Horários na hora de Portugal (Lisboa).', en: 'Times shown in Portugal time (Lisbon).', es: 'Horarios en hora de Portugal (Lisboa).', fr: 'Horaires à l’heure du Portugal (Lisbonne).' }[lang];
// RGPD: autorização explícita, nunca pré-marcada, para contacto e lembretes por WhatsApp.
const waConsent = {
  pt: 'Autorizo a SEVEN a entrar em contato comigo pelo WhatsApp sobre este agendamento, inclusive com lembretes. Posso cancelar quando quiser.',
  en: 'I authorise SEVEN to contact me on WhatsApp about this booking, including reminders. I can withdraw at any time.',
  es: 'Autorizo a SEVEN a contactarme por WhatsApp sobre esta cita, incluso con recordatorios. Puedo retirarlo cuando quiera.',
  fr: 'J’autorise SEVEN à me contacter sur WhatsApp au sujet de ce rendez-vous, y compris par des rappels. Je peux retirer mon accord à tout moment.',
}[lang];
---
<section class="pg-hero pg-hero--compact">
  <div class="container">
    <span class="eyebrow">{({ pt: 'Consultoria', en: 'Consultation', es: 'Consultoría', fr: 'Consultation' } as const)[lang]}</span>
    <h1>{copy.title}</h1>
    <p class="lede">{types.lede}</p>
  </div>
  <div class="pg-hero-mark" aria-hidden="true"></div>
</section>

<section>
  <div class="container book" style="max-width:720px"
    data-lang={lang} data-consult={consultLang} data-tz={tzNote} data-err={msgs.err} data-taken={msgs.taken} data-missing={msgs.missing} data-missing-type={types.missing} data-loading={copy.loading} data-noslots={copy.noslots}>
    <div class="book-step">
      <h3>{types.title}</h3>
      <div class="book-types" data-book-types>
        {types.items.map(([k, title, body]) => <button type="button" class="type-opt" data-c={k} aria-pressed="false"><strong>{title}</strong><span>{body}</span></button>)}
      </div>
    </div>

    <div class="book-step">
      <h3>{copy.step1}</h3>
      <div class="book-langs" data-book-langs>
        <button class="lang-opt" data-l="pt" aria-pressed={consultLang === 'pt'}>Português</button>
        <button class="lang-opt" data-l="en" aria-pressed={consultLang === 'en'}>English</button>
        <button class="lang-opt" data-l="es" aria-pressed={consultLang === 'es'}>Español</button>
      </div>
    </div>

    <div class="book-step">
      <h3>{copy.step2}</h3>
      <div data-slots class="book-slots"><p class="muted">{copy.loading}</p></div>
      <div data-slots-fallback hidden>
        <p>{copy.noslots}</p>
        <p style="margin-top:12px"><button class="btn btn-gold" data-open-attendance>{t('common.onlineService')}</button></p>
      </div>
    </div>

    <div class="book-step" data-book-details hidden>
      <h3>{copy.step3}</h3>
      <div class="book-fields">
        <input data-b-name placeholder={copy.name} autocomplete="name" />
        <input data-b-email type="email" placeholder={copy.email} autocomplete="email" />
        <input data-b-phone type="tel" placeholder={copy.phone} autocomplete="tel" />
        <label class="book-check"><input type="checkbox" data-b-wa /><span>{waConsent}</span></label>
      </div>
      <button class="btn btn-gold btn-block" style="margin-top:14px" data-book-pay>{copy.book}</button>
      <p class="book-msg" data-book-msg role="alert" hidden></p>
    </div>
  </div>
</section>

<style is:global>
  .book-step { margin-bottom: 32px; }
  .book-step h3 { margin-bottom: 14px; }
  .book-langs, .book-days, .book-times { display: flex; flex-wrap: wrap; gap: 10px; }
  .book-types { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .type-opt { display: grid; gap: 6px; text-align: left; cursor: pointer; padding: 16px; border: 1px solid var(--border-strong); background: var(--surface); font: inherit; color: var(--ink); }
  .type-opt strong { font-family: var(--font-head); font-size: 1.02rem; color: var(--heading); }
  .type-opt span { font-size: .86rem; line-height: 1.45; color: var(--ink-muted); }
  .type-opt:hover { border-color: var(--heading); }
  .type-opt[aria-pressed='true'] { background: var(--heading); border-color: var(--heading); }
  .type-opt[aria-pressed='true'] strong { color: var(--accent); }
  .type-opt[aria-pressed='true'] span { color: var(--nevoa); }
  @media (max-width: 640px) { .book-types { grid-template-columns: 1fr; } }
  .book-picker { display: grid; grid-template-columns: minmax(0, 340px) 1fr; gap: 28px; align-items: start; }
  .book-times { display: grid; grid-template-columns: repeat(auto-fill, minmax(84px, 1fr)); gap: 8px; }
  .book-times-head { font-family: var(--font-head); font-weight: 600; color: var(--heading); margin-bottom: 12px; }
  .book-times-head::first-letter, .cal-head strong::first-letter { text-transform: uppercase; }
  .cal { border: 1px solid var(--border-strong); background: var(--surface); padding: 14px; }
  .cal-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
  .cal-head strong { font-family: var(--font-head); color: var(--heading); display: inline-block; }
  .cal-nav { background: none; border: 1px solid var(--border-strong); width: 32px; height: 32px; cursor: pointer; font-size: 1.1rem; color: var(--heading); }
  .cal-nav:disabled { opacity: .3; cursor: default; }
  .cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; text-align: center; }
  .cal-wd { font-size: .7rem; text-transform: uppercase; letter-spacing: .06em; color: var(--ink-muted); padding: 4px 0; }
  .cal-day { aspect-ratio: 1; display: grid; place-items: center; font: 600 .9rem/1 var(--font-head); border: 1px solid transparent; background: none; }
  button.cal-day { cursor: pointer; color: var(--heading); background: var(--surface-alt); }
  button.cal-day:hover { border-color: var(--heading); }
  button.cal-day[aria-pressed='true'] { background: var(--heading); color: var(--accent); }
  .cal-day.off { color: var(--border-strong); font-weight: 400; }
  @media (max-width: 720px) { .book-picker { grid-template-columns: 1fr; } }
  .book-slots { display: grid; gap: 16px; }
  .book-tz { font-size: .85rem; }
  .book-msg { margin-top: 12px; padding: 10px 12px; background: #FEE2E2; color: #991B1B; font-size: .9rem; }
  .lang-opt, .slot-opt, .day-opt {
    font: inherit; font-family: var(--font-head); font-weight: 600; cursor: pointer;
    padding: 10px 16px; border: 1px solid var(--b2); border-radius: var(--radius-sm); background: var(--surface); color: var(--heading);
  }
  .day-opt { text-transform: capitalize; }
  .lang-opt[aria-pressed='true'], .slot-opt[aria-pressed='true'], .day-opt[aria-pressed='true'] { background: var(--g1); border-color: var(--g2); }
  .book-fields { display: grid; gap: 10px; }
  .book-check { display: flex; gap: 10px; align-items: flex-start; font-size: .84rem; line-height: 1.45; cursor: pointer; }
  .book-fields .book-check input { width: 16px; height: 16px; padding: 0; margin-top: 2px; flex: none; accent-color: var(--heading); }
  .book-fields input { font: inherit; padding: 11px 12px; border: 1px solid var(--b2); border-radius: var(--r-md); background: var(--off); }
</style>

<script>
  import { getAvailability, createBooking, createBookingCheckout } from '../../lib/api';

  const root = document.querySelector('.book') as HTMLElement;
  const lang = root.dataset.lang || 'pt';
  let selectedLang = root.dataset.consult || lang;
  let selectedSlot: { start: string; end: string } | null = null;
  let selectedType = '';
  document.querySelectorAll<HTMLElement>('[data-book-types] .type-opt').forEach((b) =>
    b.addEventListener('click', () => {
      selectedType = b.dataset.c || '';
      document.querySelectorAll('[data-book-types] .type-opt').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    })
  );

  const slotsEl = document.querySelector('[data-slots]') as HTMLElement;
  const fallbackEl = document.querySelector('[data-slots-fallback]') as HTMLElement;
  const detailsEl = document.querySelector('[data-book-details]') as HTMLElement;

  document.querySelectorAll('[data-book-langs] .lang-opt').forEach((b) =>
    b.addEventListener('click', () => {
      selectedLang = (b as HTMLElement).dataset.l!;
      document.querySelectorAll('[data-book-langs] .lang-opt').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    })
  );

  // Horários sempre mostrados na hora de Portugal (a agenda da equipa é em Lisboa).
  const TZ = 'Europe/Lisbon';
  const dayKey = (iso: string) => new Intl.DateTimeFormat('en-CA', { timeZone: TZ, year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date(iso));
  const dayLabel = (iso: string) => new Intl.DateTimeFormat(lang, { timeZone: TZ, weekday: 'short', day: '2-digit', month: 'short' }).format(new Date(iso));
  const timeLabel = (iso: string) => new Intl.DateTimeFormat(lang, { timeZone: TZ, hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).format(new Date(iso));

  async function loadSlots() {
    try {
      const from = new Date().toISOString();
      const to = new Date(Date.now() + 31 * 864e5).toISOString();
      const { slots } = await getAvailability({ from, to, language: selectedLang });
      if (!slots?.length) throw new Error('no slots');
      const byDay = new Map<string, { start: string; end: string }[]>();
      for (const s of slots) { const k = dayKey(s.start); if (!byDay.has(k)) byDay.set(k, []); byDay.get(k)!.push(s); }
      const keys = [...byDay.keys()].sort();
      const months = [...new Set(keys.map((k) => k.slice(0, 7)))];
      let mi = 0;
      let selectedDay = '';
      slotsEl.innerHTML = '';
      const cal = document.createElement('div'); cal.className = 'cal';
      const times = document.createElement('div'); times.className = 'book-times';
      const timesHead = document.createElement('p'); timesHead.className = 'book-times-head';
      const note = document.createElement('p'); note.className = 'book-tz muted'; note.textContent = root.dataset.tz || '';
      // Semana começando na segunda-feira, nomes no idioma da página.
      const weekdays = Array.from({ length: 7 }, (_, i) => new Intl.DateTimeFormat(lang, { weekday: 'short', timeZone: 'UTC' }).format(new Date(Date.UTC(2024, 0, 1 + i))));
      function showDay(k: string) {
        selectedDay = k;
        cal.querySelectorAll('.cal-day').forEach((x) => x.setAttribute('aria-pressed', String((x as HTMLElement).dataset.k === k)));
        times.innerHTML = '';
        selectedSlot = null; detailsEl.hidden = true;
        timesHead.textContent = dayLabel(byDay.get(k)![0].start);
        byDay.get(k)!.forEach((s) => {
          const btn = document.createElement('button');
          btn.type = 'button'; btn.className = 'slot-opt'; btn.textContent = timeLabel(s.start);
          btn.addEventListener('click', () => {
            selectedSlot = s;
            times.querySelectorAll('.slot-opt').forEach((x) => x.setAttribute('aria-pressed', String(x === btn)));
            detailsEl.hidden = false;
            detailsEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          });
          times.appendChild(btn);
        });
      }
      function render() {
        const [y, m] = months[mi].split('-').map(Number);
        const monthName = new Intl.DateTimeFormat(lang, { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(Date.UTC(y, m - 1, 1)));
        const firstDow = (new Date(Date.UTC(y, m - 1, 1)).getUTCDay() + 6) % 7;
        const daysInMonth = new Date(Date.UTC(y, m, 0)).getUTCDate();
        let html = `<div class="cal-head"><button type="button" class="cal-nav" data-prev ${mi === 0 ? 'disabled' : ''} aria-label="‹">‹</button><strong>${monthName}</strong><button type="button" class="cal-nav" data-next ${mi === months.length - 1 ? 'disabled' : ''} aria-label="›">›</button></div><div class="cal-grid">`;
        html += weekdays.map((w) => `<span class="cal-wd">${w}</span>`).join('');
        html += '<span></span>'.repeat(firstDow);
        for (let d = 1; d <= daysInMonth; d++) {
          const k = `${months[mi]}-${String(d).padStart(2, '0')}`;
          html += byDay.has(k)
            ? `<button type="button" class="cal-day" data-k="${k}" aria-pressed="${k === selectedDay}">${d}</button>`
            : `<span class="cal-day off">${d}</span>`;
        }
        cal.innerHTML = html + '</div>';
        cal.querySelector('[data-prev]')?.addEventListener('click', () => { mi--; render(); });
        cal.querySelector('[data-next]')?.addEventListener('click', () => { mi++; render(); });
        cal.querySelectorAll<HTMLElement>('.cal-day[data-k]').forEach((b) => b.addEventListener('click', () => showDay(b.dataset.k!)));
      }
      render();
      showDay(keys[0]);
      const wrap = document.createElement('div'); wrap.className = 'book-picker';
      const right = document.createElement('div'); right.append(timesHead, times);
      wrap.append(cal, right);
      slotsEl.append(wrap, note);
    } catch {
      slotsEl.hidden = true;
      fallbackEl.hidden = false;
    }
  }
  loadSlots();

  const payBtn = document.querySelector('[data-book-pay]') as HTMLButtonElement;
  const payMsg = document.querySelector('[data-book-msg]') as HTMLElement;
  payBtn?.addEventListener('click', async () => {
    if (!selectedSlot) return;
    const val = (sel: string) => (document.querySelector(sel) as HTMLInputElement).value.trim();
    const name = val('[data-b-name]'), email = val('[data-b-email]'), phone = val('[data-b-phone]');
    payMsg.hidden = true;
    if (!selectedType) { payMsg.textContent = root.dataset.missingType || ''; payMsg.hidden = false; document.querySelector('[data-book-types]')?.scrollIntoView({ behavior: 'smooth', block: 'center' }); return; }
    if (!name || !/^\S+@\S+\.\S+$/.test(email) || phone.replace(/\D/g, '').length < 6) {
      payMsg.textContent = root.dataset.missing || ''; payMsg.hidden = false; return;
    }
    payBtn.disabled = true;
    try {
      const { booking_id } = await createBooking({
        language: selectedLang,
        service_code: 'CONSULT',
        consult_type: selectedType,
        slot_start: selectedSlot.start,
        slot_end: selectedSlot.end,
        whatsapp_consent: (document.querySelector('[data-b-wa]') as HTMLInputElement)?.checked ?? false,
        customer: { name, email, phone },
      });
      const { url } = await createBookingCheckout(booking_id, selectedLang);
      window.location.href = url;
    } catch (e) {
      const taken = String((e as Error)?.message || '').includes('slot_taken');
      payMsg.textContent = (taken ? root.dataset.taken : root.dataset.err) || ''; payMsg.hidden = false;
      payBtn.disabled = false;
      if (taken) loadSlots();
    }
  });
</script>
