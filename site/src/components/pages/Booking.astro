---
import { useTranslations, getRoute, type Lang } from '../../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);

const copy = {
  pt: { title: 'Agendar consultoria', step1: '1. Idioma da consultoria', step2: '2. Escolha um horário', step3: '3. Seus dados', noslots: 'Os horários online vão estar disponíveis em breve. Enquanto isso, fale com um especialista:', name: 'Nome completo', email: 'E-mail', phone: 'Celular', pay: 'Pagar e confirmar', loading: 'Carregando horários…', book: 'Reservar e pagar' },
  en: { title: 'Book a consultation', step1: '1. Consultation language', step2: '2. Choose a time', step3: '3. Your details', noslots: 'Online time slots will be available soon. In the meantime, talk to a specialist:', name: 'Full name', email: 'Email', phone: 'Mobile phone', pay: 'Pay and confirm', loading: 'Loading time slots…', book: 'Book and pay' },
  es: { title: 'Agendar consultoría', step1: '1. Idioma de la consultoría', step2: '2. Elige un horario', step3: '3. Tus datos', noslots: 'Los horarios online estarán disponibles pronto. Mientras tanto, habla con un especialista:', name: 'Nombre completo', email: 'Correo electrónico', phone: 'Celular', pay: 'Pagar y confirmar', loading: 'Cargando horarios…', book: 'Reservar y pagar' },
  fr: { title: 'Prendre rendez-vous', step1: '1. Langue de la consultation', step2: '2. Choisissez un créneau', step3: '3. Vos coordonnées', noslots: 'Les créneaux en ligne seront bientôt disponibles. En attendant, parlez à un spécialiste :', name: 'Nom complet', email: 'E-mail', phone: 'Téléphone portable', pay: 'Payer et confirmer', loading: 'Chargement des créneaux…', book: 'Réserver et payer' },
}[lang];
// Consultas são feitas em PT/EN/ES; para FR, o idioma inicial sugerido é o inglês.
const consultLang = lang === 'fr' ? 'en' : lang;
const msgs = {
  pt: { err: 'Não deu para reservar. Tente de novo ou chame a gente no WhatsApp.', taken: 'Esse horário acabou de ser reservado. Escolha outro.', missing: 'Preencha nome, e-mail e celular para continuar.' },
  en: { err: 'We could not book it. Please try again or message us on WhatsApp.', taken: 'That time was just booked. Please choose another.', missing: 'Please fill in your name, email and phone to continue.' },
  es: { err: 'No se pudo reservar. Inténtalo de nuevo o escríbenos por WhatsApp.', taken: 'Ese horario acaba de reservarse. Elige otro.', missing: 'Completa nombre, correo y celular para continuar.' },
  fr: { err: 'La réservation n’a pas abouti. Réessayez ou écrivez-nous sur WhatsApp.', taken: 'Ce créneau vient d’être réservé. Choisissez-en un autre.', missing: 'Indiquez votre nom, e-mail et téléphone pour continuer.' },
}[lang];
const tzNote = { pt: 'Horários na hora de Portugal (Lisboa).', en: 'Times shown in Portugal time (Lisbon).', es: 'Horarios en hora de Portugal (Lisboa).', fr: 'Horaires à l’heure du Portugal (Lisbonne).' }[lang];
// RGPD: autorização explícita, nunca pré-marcada, para contacto e lembretes por WhatsApp.
const waConsent = {
  pt: 'Autorizo a SEVEN a entrar em contato comigo pelo WhatsApp sobre este agendamento, inclusive com lembretes. Posso cancelar quando quiser.',
  en: 'I authorise SEVEN to contact me on WhatsApp about this booking, including reminders. I can withdraw at any time.',
  es: 'Autorizo a SEVEN a contactarme por WhatsApp sobre esta cita, incluso con recordatorios. Puedo retirarlo cuando quiera.',
  fr: 'J’autorise SEVEN à me contacter sur WhatsApp au sujet de ce rendez-vous, y compris par des rappels. Je peux retirer mon accord à tout moment.',
}[lang];
---
<section class="bg-navy center">
  <div class="container" style="max-width:720px">
    <span class="eyebrow">{t('nav.booking')}</span>
    <h1>{copy.title}</h1>
    <p class="lead" style="margin-inline:auto">{t('home.cta.body')}</p>
  </div>
</section>

<section>
  <div class="container book" style="max-width:720px"
    data-lang={lang} data-consult={consultLang} data-tz={tzNote} data-err={msgs.err} data-taken={msgs.taken} data-missing={msgs.missing} data-loading={copy.loading} data-noslots={copy.noslots}>
    <div class="book-step">
      <h3>{copy.step1}</h3>
      <div class="book-langs" data-book-langs>
        <button class="lang-opt" data-l="pt" aria-pressed={consultLang === 'pt'}>Português</button>
        <button class="lang-opt" data-l="en" aria-pressed={consultLang === 'en'}>English</button>
        <button class="lang-opt" data-l="es" aria-pressed={consultLang === 'es'}>Español</button>
      </div>
    </div>

    <div class="book-step">
      <h3>{copy.step2}</h3>
      <div data-slots class="book-slots"><p class="muted">{copy.loading}</p></div>
      <div data-slots-fallback hidden>
        <p>{copy.noslots}</p>
        <p style="margin-top:12px"><button class="btn btn-gold" data-open-attendance>{t('common.onlineService')}</button></p>
      </div>
    </div>

    <div class="book-step" data-book-details hidden>
      <h3>{copy.step3}</h3>
      <div class="book-fields">
        <input data-b-name placeholder={copy.name} autocomplete="name" />
        <input data-b-email type="email" placeholder={copy.email} autocomplete="email" />
        <input data-b-phone type="tel" placeholder={copy.phone} autocomplete="tel" />
        <label class="book-check"><input type="checkbox" data-b-wa /><span>{waConsent}</span></label>
      </div>
      <button class="btn btn-gold btn-block" style="margin-top:14px" data-book-pay>{copy.book}</button>
      <p class="book-msg" data-book-msg role="alert" hidden></p>
    </div>
  </div>
</section>

<style>
  .book-step { margin-bottom: 32px; }
  .book-step h3 { margin-bottom: 14px; }
  .book-langs, .book-days, .book-times { display: flex; flex-wrap: wrap; gap: 10px; }
  .book-slots { display: grid; gap: 16px; }
  .book-tz { font-size: .85rem; }
  .book-msg { margin-top: 12px; padding: 10px 12px; background: #FEE2E2; color: #991B1B; font-size: .9rem; }
  .lang-opt, .slot-opt, .day-opt {
    font: inherit; font-family: var(--font-head); font-weight: 600; cursor: pointer;
    padding: 10px 16px; border: 1px solid var(--b2); border-radius: var(--radius-sm); background: var(--surface); color: var(--heading);
  }
  .day-opt { text-transform: capitalize; }
  .lang-opt[aria-pressed='true'], .slot-opt[aria-pressed='true'], .day-opt[aria-pressed='true'] { background: var(--g1); border-color: var(--g2); }
  .book-fields { display: grid; gap: 10px; }
  .book-check { display: flex; gap: 10px; align-items: flex-start; font-size: .84rem; line-height: 1.45; cursor: pointer; }
  .book-fields .book-check input { width: 16px; height: 16px; padding: 0; margin-top: 2px; flex: none; accent-color: var(--heading); }
  .book-fields input { font: inherit; padding: 11px 12px; border: 1px solid var(--b2); border-radius: var(--r-md); background: var(--off); }
</style>

<script>
  import { getAvailability, createBooking, createBookingCheckout } from '../../lib/api';

  const root = document.querySelector('.book') as HTMLElement;
  const lang = root.dataset.lang || 'pt';
  let selectedLang = root.dataset.consult || lang;
  let selectedSlot: { start: string; end: string } | null = null;

  const slotsEl = document.querySelector('[data-slots]') as HTMLElement;
  const fallbackEl = document.querySelector('[data-slots-fallback]') as HTMLElement;
  const detailsEl = document.querySelector('[data-book-details]') as HTMLElement;

  document.querySelectorAll('[data-book-langs] .lang-opt').forEach((b) =>
    b.addEventListener('click', () => {
      selectedLang = (b as HTMLElement).dataset.l!;
      document.querySelectorAll('[data-book-langs] .lang-opt').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    })
  );

  // Horários sempre mostrados na hora de Portugal (a agenda da equipa é em Lisboa).
  const TZ = 'Europe/Lisbon';
  const dayKey = (iso: string) => new Intl.DateTimeFormat('en-CA', { timeZone: TZ, year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date(iso));
  const dayLabel = (iso: string) => new Intl.DateTimeFormat(lang, { timeZone: TZ, weekday: 'short', day: '2-digit', month: 'short' }).format(new Date(iso));
  const timeLabel = (iso: string) => new Intl.DateTimeFormat(lang, { timeZone: TZ, hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).format(new Date(iso));

  async function loadSlots() {
    try {
      const from = new Date().toISOString();
      const to = new Date(Date.now() + 14 * 864e5).toISOString();
      const { slots } = await getAvailability({ from, to, language: selectedLang });
      if (!slots?.length) throw new Error('no slots');
      const byDay = new Map<string, { start: string; end: string }[]>();
      for (const s of slots) { const k = dayKey(s.start); if (!byDay.has(k)) byDay.set(k, []); byDay.get(k)!.push(s); }
      slotsEl.innerHTML = '';
      const days = document.createElement('div'); days.className = 'book-days';
      const times = document.createElement('div'); times.className = 'book-times';
      const note = document.createElement('p'); note.className = 'book-tz muted'; note.textContent = root.dataset.tz || '';
      const showDay = (k: string, chip: HTMLElement) => {
        days.querySelectorAll('.day-opt').forEach((x) => x.setAttribute('aria-pressed', String(x === chip)));
        times.innerHTML = '';
        selectedSlot = null; detailsEl.hidden = true;
        byDay.get(k)!.forEach((s) => {
          const btn = document.createElement('button');
          btn.type = 'button'; btn.className = 'slot-opt'; btn.textContent = timeLabel(s.start);
          btn.addEventListener('click', () => {
            selectedSlot = s;
            times.querySelectorAll('.slot-opt').forEach((x) => x.setAttribute('aria-pressed', String(x === btn)));
            detailsEl.hidden = false;
          });
          times.appendChild(btn);
        });
      };
      let first = true;
      for (const [k, list] of byDay) {
        const chip = document.createElement('button');
        chip.type = 'button'; chip.className = 'day-opt'; chip.textContent = dayLabel(list[0].start);
        chip.addEventListener('click', () => showDay(k, chip));
        days.appendChild(chip);
        if (first) { showDay(k, chip); first = false; }
      }
      slotsEl.append(days, times, note);
    } catch {
      slotsEl.hidden = true;
      fallbackEl.hidden = false;
    }
  }
  loadSlots();

  const payBtn = document.querySelector('[data-book-pay]') as HTMLButtonElement;
  const payMsg = document.querySelector('[data-book-msg]') as HTMLElement;
  payBtn?.addEventListener('click', async () => {
    if (!selectedSlot) return;
    const val = (sel: string) => (document.querySelector(sel) as HTMLInputElement).value.trim();
    const name = val('[data-b-name]'), email = val('[data-b-email]'), phone = val('[data-b-phone]');
    payMsg.hidden = true;
    if (!name || !/^\S+@\S+\.\S+$/.test(email) || phone.replace(/\D/g, '').length < 6) {
      payMsg.textContent = root.dataset.missing || ''; payMsg.hidden = false; return;
    }
    payBtn.disabled = true;
    try {
      const { booking_id } = await createBooking({
        language: selectedLang,
        service_code: 'CONSULT',
        slot_start: selectedSlot.start,
        slot_end: selectedSlot.end,
        whatsapp_consent: (document.querySelector('[data-b-wa]') as HTMLInputElement)?.checked ?? false,
        customer: { name, email, phone },
      });
      const { url } = await createBookingCheckout(booking_id, selectedLang);
      window.location.href = url;
    } catch (e) {
      const taken = String((e as Error)?.message || '').includes('slot_taken');
      payMsg.textContent = (taken ? root.dataset.taken : root.dataset.err) || ''; payMsg.hidden = false;
      payBtn.disabled = false;
      if (taken) loadSlots();
    }
  });
</script>
