---
import { getRoute, type Lang } from '../../i18n/ui';
import { getUi } from '../../data/ui';
import { aboutCopy, brandCopy } from '../../data/about-copy';
import { STAGES, solutionsByStageFor, solutionPath } from '../../data/solucoes';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const u = getUi(lang);
const copy = aboutCopy(lang);
const brand = brandCopy(lang);
const title = { pt: 'Missão e valores', en: 'Mission and values', es: 'Misión y valores', fr: 'Mission et valeurs' }[lang];
const journey = STAGES.map((st) => {
  const first = solutionsByStageFor(lang, st.id)[0];
  return { step: st.step, title: u.stages[st.id].title, summary: u.stages[st.id].summary, href: first ? solutionPath(lang, first) : getRoute('solutions', lang) };
});
---
<section class="pg-hero pg-hero--compact">
  <div class="container">
    <span class="eyebrow">{title}</span>
    <h1>{brand.heroH1} <em>{brand.heroEm}</em></h1>
    <p class="lede">{copy.mission[0]}</p>
  </div>
  <div class="pg-hero-mark" aria-hidden="true"></div>
</section>

<section class="bg-white">
  <div class="container mv-grid">
    <div>
      <span class="eyebrow">{brand.missionEyebrow}</span>
      <p class="mv-mission">{copy.mission[1]}</p>
    </div>
    <div class="mv-manifesto on-brand">
      <span class="eyebrow">{brand.manifestoEyebrow}</span>
      <ul>{brand.manifesto.map((l) => <li>{l}</li>)}</ul>
      <p class="mv-close">{brand.manifestoClose}</p>
    </div>
  </div>
</section>

<section class="bg-off">
  <div class="container">
    <div class="sec-head"><span class="eyebrow">{brand.beliefsEyebrow}</span><h2>{copy.beliefsTitle}</h2></div>
    <div class="tiles tiles-3">
      {brand.beliefTiles.map((t, i) => <div class="tile"><h3>{t}</h3><p>{copy.beliefs[i]}</p></div>)}
    </div>
    <blockquote class="belief-quote">“{brand.beliefQuote}”<cite>Danilo Jesus</cite></blockquote>
  </div>
</section>

<section class="bg-white">
  <div class="container">
    <div class="sec-head"><span class="eyebrow">{brand.workEyebrow}</span><h2>{copy.workTitle}</h2></div>
    <div class="tiles tiles-3">
      {copy.work.map(([t, b]) => <div class="tile"><h3>{t}</h3><p>{b}</p></div>)}
    </div>
  </div>
</section>

<section class="bg-off">
  <div class="container">
    <div class="sec-head"><span class="eyebrow">{brand.journeyEyebrow}</span><h2>{brand.journeyTitle}</h2><p class="lead">{brand.journeyLead}</p></div>
    <div class="link-cards">
      {journey.map((j) => <a href={j.href} class="link-card"><span class="journey-step">{j.step}</span><h3>{j.title}</h3><p>{j.summary}</p><span class="go">{u.common.learnMore}</span></a>)}
    </div>
  </div>
</section>

<section class="sign-band">
  <div class="container">
    <h2 style="margin-top:0">{brand.closingTitle}</h2>
    <p>{brand.closingBody}</p>
    <div class="ctas">
      <a href={getRoute('expert', lang)} class="btn btn-gold">{u.common.talkToExpert}</a>
      <a href={getRoute('booking', lang)} class="btn btn-ghost">{u.common.bookConsult}</a>
    </div>
  </div>
</section>

<style>
  .mv-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 5vw, 64px); align-items: start; }
  .mv-mission { margin-top: 14px; font-size: 1.15rem; line-height: 1.7; color: var(--ink); }
  .mv-manifesto { background: var(--surface-brand); color: var(--nevoa); padding: clamp(22px, 3vw, 32px); }
  .mv-manifesto .eyebrow { color: var(--areia); }
  .mv-manifesto ul { list-style: none; margin-top: 12px; display: grid; gap: 8px; }
  .mv-manifesto li { font-family: var(--font-head); font-weight: 600; font-size: 1.02rem; line-height: 1.4; color: var(--branco); }
  .mv-close { margin-top: 16px; padding-top: 14px; border-top: 2px solid var(--accent); font-family: var(--font-head); font-weight: 700; text-transform: uppercase; color: var(--areia); }
  .belief-quote { margin-top: 28px; max-width: 760px; border-left: 4px solid var(--accent); padding: 6px 0 6px 20px; font-family: var(--font-head); font-weight: 600; font-size: clamp(1.1rem, 2vw, 1.4rem); color: var(--heading); }
  .belief-quote cite { display: block; margin-top: 8px; font-style: normal; font-size: .8rem; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-muted); }
  .journey-step { font-family: var(--font-head); font-weight: 700; font-size: 1.4rem; color: var(--heading); }
  @media (max-width: 820px) { .mv-grid { grid-template-columns: 1fr; } }
</style>
