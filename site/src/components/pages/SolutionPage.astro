---
import type { Solution } from '../../data/solution-types';
import { solutionFor, solutionPath } from '../../data/solucoes';
import { getUi } from '../../data/ui';
import { getRoute, type Lang } from '../../i18n/ui';
import WhatsAppButton from '../WhatsAppButton.astro';
import { mainWhatsapp, waText } from '../../lib/site';

interface Props { solution: Solution; lang?: Lang; }
const { solution: s, lang = 'pt' } = Astro.props;
const u = getUi(lang);
const wa = await mainWhatsapp();
const related = s.related.map((k) => solutionFor(lang, k)).filter((x): x is Solution => Boolean(x));
const booking = getRoute('booking', lang);
const expert = getRoute('expert', lang);
const home = getRoute('home', lang);
const hub = getRoute('solutions', lang);
---
<section class="pg-hero">
  <div class="container">
    <nav aria-label={u.common.breadcrumbAria}>
      <ol class="crumbs">
        <li><a href={home}>{u.common.home}</a></li>
        <li><a href={hub}>{u.common.solutions}</a></li>
        <li aria-current="page">{s.navLabel}</li>
      </ol>
    </nav>
    <span class="eyebrow">{s.eyebrow}</span>
    <h1>{s.h1}</h1>
    <p class="lede">{s.lede}</p>
    <div class="ctas">
      <a href={expert} class="btn btn-gold">{u.common.talkToExpert}</a>
      <a href={booking} class="btn btn-ghost">{u.common.bookConsult}</a>
      <WhatsAppButton whatsapp={wa} text={waText(s.navLabel, lang)} label={u.common.whatsapp} />
    </div>
    {s.highlights.length > 0 && (
      <div class="pg-highlights">
        {s.highlights.map((h) => <div><strong>{h.value}</strong><span>{h.label}</span></div>)}
      </div>
    )}
  </div>
  <div class="pg-hero-mark" aria-hidden="true"></div>
</section>

<section class="bg-white">
  <div class="container">
    <div class="sec-head">
      <span class="eyebrow">{u.solution.forWho}</span>
      <h2>{s.forWhoTitle}</h2>
    </div>
    <div class:list={['tiles', s.forWho.length % 3 === 0 ? 'tiles-3' : 'tiles-2']}>
      {s.forWho.map((it) => <div class="tile"><h3>{it.title}</h3><p>{it.body}</p></div>)}
    </div>
    {s.dictionary && s.dictionary.length > 0 && (
      <aside class="dict" style="margin-top:32px">
        <h2>{u.solution.dictionary}</h2>
        <dl>{s.dictionary.map((d) => <><dt>{d.term}</dt><dd>{d.meaning}</dd></>)}</dl>
      </aside>
    )}
  </div>
</section>

<section class="bg-off">
  <div class="container">
    <div class="sec-head">
      <span class="eyebrow">{u.solution.whatWeDo}</span>
      <h2>{s.includedTitle}</h2>
    </div>
    <div class:list={['tiles', s.included.length % 3 === 0 ? 'tiles-3' : 'tiles-2']}>
      {s.included.map((it) => <div class="tile"><h3>{it.title}</h3><p>{it.body}</p></div>)}
    </div>
  </div>
</section>

<section class="bg-white">
  <div class="container">
    <div class="sec-head">
      <span class="eyebrow">{u.solution.howItWorks}</span>
      <h2>{s.stepsTitle}</h2>
    </div>
    <ol class="steps-list">
      {s.steps.map((st, i) => (
        <li><span class="n">{String(i + 1).padStart(2, '0')}</span><div><h3>{st.title}</h3><p>{st.body}</p></div></li>
      ))}
    </ol>
    {s.important && (
      <div class="notice" style="margin-top:40px">
        <h3>{s.important.title}</h3>
        <p>{s.important.body}</p>
      </div>
    )}
    {s.external && (
      <div class="ext" style="margin-top:24px">
        <div><h3>{s.external.title}</h3><p>{s.external.body}</p></div>
        <a href={s.external.href} class="btn btn-ghost" target="_blank" rel="noopener">{s.external.label}</a>
      </div>
    )}
  </div>
</section>

<section class="bg-off">
  <div class="container">
    <div class="sec-head">
      <span class="eyebrow">{u.solution.faqEyebrow}</span>
      <h2>{u.solution.faqTitle}</h2>
    </div>
    <div class="faq-list">
      {s.faqs.map((f) => (
        <details><summary>{f.q}</summary><p class="a">{f.a}</p></details>
      ))}
    </div>
  </div>
</section>

{related.length > 0 && (
  <section class="bg-white">
    <div class="container">
      <div class="sec-head">
        <span class="eyebrow">{u.solution.nextSteps}</span>
        <h2>{u.solution.nextStepsTitle}</h2>
      </div>
      <div class="link-cards">
        {related.map((r) => (
          <a href={solutionPath(lang, r)} class="link-card"><h3>{r.navLabel}</h3><p>{r.cardSummary}</p><span class="go">{u.common.learnMore}</span></a>
        ))}
      </div>
    </div>
  </section>
)}

<section class="sign-band">
  <div class="container">
    <p class="statement">{u.solution.statement}</p>
    <h2>{s.ctaTitle}</h2>
    <p>{s.ctaBody}</p>
    <div class="ctas">
      <a href={expert} class="btn btn-gold">{u.common.talkToExpert}</a>
      <a href={booking} class="btn btn-ghost">{u.common.bookConsult}</a>
      <WhatsAppButton whatsapp={wa} text={waText(s.navLabel, lang)} label={u.common.whatsapp} />
    </div>
  </div>
</section>
