---
import Base from '../layouts/Base.astro';
import SolutionPage from '../components/pages/SolutionPage.astro';
import { solutions, keyOf, solutionAlternates } from '../data/solucoes';
import type { Solution } from '../data/solution-types';
import { solutionJsonLd } from '../lib/solution-page';

export function getStaticPaths() {
  return solutions.map((solution) => ({ params: { solucao: solution.slug }, props: { solution } }));
}

interface Props { solution: Solution; }
const { solution: s } = Astro.props;
---
<Base title={s.seoTitle} description={s.metaDescription} jsonLd={solutionJsonLd('pt', s)} alternates={solutionAlternates(keyOf(s))}>
  <SolutionPage solution={s} lang="pt" />
</Base>
